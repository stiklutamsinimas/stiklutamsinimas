---
interface Props {
  steps?: { title: string; text: string }[];
}

const defaultSteps = [
  {
    title: 'Susisiekite',
    text: 'Paskambinkite, parašykite per WhatsApp ar užpildykite užklausą. Darbus atliekame tik iš anksto susitarus.',
  },
  {
    title: 'Konsultacija ir kaina',
    text: 'Patarsime, kokia plėvelė tinka jūsų poreikiams, ir iš anksto pasakysime kainą. Jokių netikėtumų.',
  },
  {
    title: 'Atliekame darbą',
    text: 'Dirbame kruopščiai ir tvarkingai – dirbtuvėse arba atvykę pas jus (mobilus tamsinimas).',
  },
  {
    title: 'Rezultatas su garantija',
    text: 'Patikriname kokybę kartu su jumis, paaiškiname priežiūrą ir suteikiame 5 metų ar ilgesnę garantiją.',
  },
];

const { steps = defaultSteps } = Astro.props;
---

<ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {
    steps.map((step, i) => (
      <li class="relative rounded-3xl border border-white/10 bg-white/[0.03] p-6">
        <span class="font-display text-5xl font-extrabold text-brand-500/25">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-4 text-lg font-bold text-white">{step.title}</h3>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-300">{step.text}</p>
      </li>
    ))
  }
</ol>
