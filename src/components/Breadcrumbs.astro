---
import { ChevronRight } from '@lucide/astro';

interface Props {
  items: { name: string; url: string }[];
  dark?: boolean;
}

const { items, dark = true } = Astro.props;
---

<nav aria-label="Navigacijos kelias">
  <ol class:list={['flex flex-wrap items-center gap-1.5 text-sm', dark ? 'text-ink-300' : 'text-ink-500']}>
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <ChevronRight size={14} class="opacity-50" aria-hidden="true" />}
          {i < items.length - 1 ? (
            <a href={item.url} class:list={['hover:underline', dark ? 'hover:text-white' : 'hover:text-ink-900']}>
              {item.name}
            </a>
          ) : (
            <span aria-current="page" class:list={[dark ? 'text-white' : 'text-ink-900']}>
              {item.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
