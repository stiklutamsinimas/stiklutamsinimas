---
import { Image } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import Icon from '@/components/ui/Icon.astro';
import { serviceUrl, type Service } from '@/lib/services';

interface Props {
  service: Service;
  /** Didesnė kortelė (pvz. pagrindinė paslauga) */
  featured?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { service, featured = false, headingLevel: H = 'h3' } = Astro.props;
const { data } = service;
---

<a
  href={serviceUrl(service.id)}
  class:list={[
    'group relative isolate flex flex-col overflow-hidden rounded-3xl bg-ink-900 text-white',
    featured ? 'min-h-[26rem] sm:min-h-[30rem]' : 'min-h-[22rem]',
  ]}
>
  <Image
    src={data.cover}
    alt={data.coverAlt}
    widths={[480, 720, 960]}
    sizes={featured ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'}
    class="absolute inset-0 -z-10 h-full w-full object-cover transition duration-700 group-hover:scale-105"
    layout="none"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-950 via-ink-950/60 to-ink-950/5"></div>

  <div class="flex items-start justify-between p-6">
    <span class="grid size-11 place-items-center rounded-2xl bg-white/10 text-brand-300 ring-1 ring-white/15 backdrop-blur">
      <Icon name={data.icon} size={20} />
    </span>
    <span
      class="grid size-11 place-items-center rounded-full bg-white/10 ring-1 ring-white/15 backdrop-blur transition duration-300 group-hover:bg-brand-500 group-hover:text-ink-950"
      aria-hidden="true"
    >
      <ArrowUpRight size={20} />
    </span>
  </div>

  <div class="mt-auto p-6 pt-0">
    <H class:list={['font-bold text-white', featured ? 'text-2xl sm:text-3xl' : 'text-xl']}>{data.title}</H>
    <p class="mt-2 max-w-md text-[0.95rem] leading-relaxed text-ink-200">{data.excerpt}</p>
    {
      data.prices && data.prices.length > 0 && (
        <p class="mt-4 inline-flex rounded-full bg-brand-500/15 px-3 py-1 text-sm font-semibold text-brand-300 ring-1 ring-brand-400/30">
          {data.prices[0]!.value}
        </p>
      )
    }
  </div>
</a>
