---
/**
 * Užklausos forma be serverio: paspaudus mygtuką atidaromas WhatsApp arba
 * el. pašto langas su jau surašyta žinute. Niekas nesaugoma svetainėje.
 * Ateityje galima prijungti serverinį siuntimą (pvz. Cloudflare Functions) –
 * užtenka pakeisti `submit` logiką žemiau esančiame skripte.
 */
import { Mail, MessageCircle } from '@lucide/astro';
import { site } from '@/config/site';
import { getServices } from '@/lib/services';

interface Props {
  /** Iš anksto pasirinkta paslauga (paslaugos puslapyje) */
  selected?: string;
}

const { selected } = Astro.props;
const services = await getServices();

const field =
  'mt-2 block w-full rounded-2xl border border-ink-200 bg-white px-4 py-3 text-ink-950 placeholder:text-ink-400 transition focus:border-brand-600 focus:ring-4 focus:ring-brand-500/15 focus:outline-none';
const label = 'text-sm font-semibold text-ink-800';
---

<form
  id="uzklausos-forma"
  class="card grid gap-5 p-6 sm:grid-cols-2 sm:p-8"
  data-phone={site.phone.replace('+', '')}
  data-email={site.email}
  novalidate
>
  <div>
    <label for="f-name" class={label}>Vardas *</label>
    <input id="f-name" name="vardas" type="text" autocomplete="name" required class={field} placeholder="Jūsų vardas" />
  </div>
  <div>
    <label for="f-phone" class={label}>Telefonas *</label>
    <input id="f-phone" name="telefonas" type="tel" autocomplete="tel" required class={field} placeholder="+370 6.. ....." />
  </div>
  <div>
    <label for="f-service" class={label}>Paslauga</label>
    <select id="f-service" name="paslauga" class={field}>
      <option value="">Pasirinkite paslaugą</option>
      {
        services.map((s) => (
          <option value={s.data.title} selected={s.id === selected}>
            {s.data.title}
          </option>
        ))
      }
      <option value="Kita">Kita</option>
    </select>
  </div>
  <div>
    <label for="f-city" class={label}>Miestas</label>
    <select id="f-city" name="miestas" class={field}>
      <option value="">Pasirinkite miestą</option>
      {site.locations.map((l) => <option value={l.city}>{l.city}</option>)}
      <option value="Kitas (mobilus tamsinimas)">Kitas miestas</option>
    </select>
  </div>
  <div class="sm:col-span-2">
    <label for="f-message" class={label}>Žinutė *</label>
    <textarea
      id="f-message"
      name="zinute"
      rows="4"
      required
      class={field}
      placeholder="Pvz.: BMW X5 2019 m., noriu tamsinti galinius stiklus. Kada galėtumėte?"></textarea>
  </div>

  <p class="form-error hidden text-sm font-medium text-red-600 sm:col-span-2" role="alert">
    Užpildykite vardą, telefoną ir žinutę.
  </p>

  <div class="flex flex-col gap-3 sm:col-span-2 sm:flex-row">
    <button type="submit" value="whatsapp" class="btn btn-whatsapp flex-1">
      <MessageCircle size={18} aria-hidden="true" />
      Siųsti per WhatsApp
    </button>
    <button type="submit" value="email" class="btn btn-primary flex-1">
      <Mail size={18} aria-hidden="true" />
      Siųsti el. paštu
    </button>
  </div>
  <p class="text-xs leading-relaxed text-ink-400 sm:col-span-2">
    Paspaudus atsidarys WhatsApp arba jūsų el. pašto programa su jau parašyta žinute – jums liks tik ją išsiųsti.
  </p>
</form>

<script>
  const form = document.getElementById('uzklausos-forma') as HTMLFormElement | null;
  if (form) {
    const error = form.querySelector('.form-error');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();

      if (!get('vardas') || !get('telefonas') || !get('zinute')) {
        error?.classList.remove('hidden');
        form.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }
      error?.classList.add('hidden');

      const lines = [`Sveiki, mano vardas ${get('vardas')}.`];
      if (get('paslauga')) lines.push(`Paslauga: ${get('paslauga')}`);
      if (get('miestas')) lines.push(`Miestas: ${get('miestas')}`);
      lines.push(`Telefonas: ${get('telefonas')}`, '', get('zinute'));
      const text = lines.join('\n');

      const via = (e.submitter as HTMLButtonElement | null)?.value ?? 'whatsapp';
      if (via === 'email') {
        const subject = `Užklausa${get('paslauga') ? `: ${get('paslauga')}` : ''} – ${get('vardas')}`;
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}`;
      } else {
        window.open(`https://wa.me/${form.dataset.phone}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
      }
    });
  }
</script>
