---
import { Plus } from '@lucide/astro';

interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-ink-100 rounded-3xl border border-ink-100 bg-white">
  {
    items.map((item) => (
      <details class="group px-6 sm:px-8 [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-left">
          <h3 class="text-[1.05rem] font-semibold text-ink-950 sm:text-lg">{item.q}</h3>
          <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-full bg-ink-50 text-ink-700 transition duration-300 group-open:rotate-45 group-open:bg-brand-700 group-open:text-white">
            <Plus size={18} aria-hidden="true" />
          </span>
        </summary>
        <p class="-mt-2 pb-6 leading-relaxed text-ink-600">{item.a}</p>
      </details>
    ))
  }
</div>
