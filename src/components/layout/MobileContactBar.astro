---
import { MessageCircle, Phone, Send } from '@lucide/astro';
import { site, telHref } from '@/config/site';
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-ink-950/95 px-3 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] backdrop-blur-xl lg:hidden"
>
  <div class="mx-auto grid max-w-md grid-cols-3 gap-2">
    <a href={telHref} class="flex flex-col items-center gap-0.5 rounded-2xl bg-brand-500 py-2 text-xs font-semibold text-ink-950">
      <Phone size={19} aria-hidden="true" />
      Skambinti
    </a>
    <a
      href={site.whatsapp}
      target="_blank"
      rel="noopener"
      class="flex flex-col items-center gap-0.5 rounded-2xl bg-white/5 py-2 text-xs font-semibold text-white"
    >
      <MessageCircle size={19} class="text-[#25d366]" aria-hidden="true" />
      WhatsApp
    </a>
    <a href="/kontaktai#uzklausa" class="flex flex-col items-center gap-0.5 rounded-2xl bg-white/5 py-2 text-xs font-semibold text-white">
      <Send size={19} class="text-brand-400" aria-hidden="true" />
      Užklausa
    </a>
  </div>
</div>
