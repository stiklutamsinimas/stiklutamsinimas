---
/**
 * Slapukų sutikimas + reklamos konversijų sekimas (ES reikalavimas).
 * Rodomas tik tada, kai site.ts įrašytas googleAds.id ir/ar metaPixel.id.
 * Google žyma (gtag.js) ir Meta Pixel (fbevents.js) įkeliami TIK paspaudus „Sutinku“
 * (Google – Consent Mode v2, „basic“ režimas). Atsisakius – jokių slapukų.
 */
import { googleAds, metaPixel } from '@/config/site';

const { id, labels } = googleAds;
const call = labels.call || labels.lead;
const lead = labels.lead || labels.call;
const metaId = metaPixel.id;

const who = [id && 'Google', metaId && 'Meta (Facebook, Instagram)'].filter(Boolean).join(' ir ');
const why = metaId
  ? 'padės mums matuoti, kiek žmonių susisiekia atėję iš reklamos, ir rodyti mūsų reklamą jau apsilankiusiems'
  : 'padės mums matuoti, kiek žmonių susisiekia atėję iš reklamos';
---

{
  (id || metaId) && (
    <div
      id="slapuku-langas"
      class="cookie-banner card fixed inset-x-3 bottom-3 z-[60] hidden p-5 sm:inset-x-auto sm:bottom-6 sm:left-6 sm:max-w-md"
      role="dialog"
      aria-live="polite"
      aria-label="Slapukų nustatymai"
      data-ads-id={id || undefined}
      data-label-call={call}
      data-label-lead={lead}
      data-meta-id={metaId || undefined}
    >
      <p class="text-base font-extrabold text-text">Slapukai</p>
      <p class="mt-1.5 text-sm leading-relaxed text-muted">
        Svetainė veikia ir be slapukų. Sutikus, {who} reklamos slapukai {why}. Sutikimą galite bet kada atšaukti puslapio apačioje
        („Slapukų nustatymai“).{' '}
        <a href="/privatumo-politika#slapukai" class="font-semibold text-link underline underline-offset-2">
          Plačiau
        </a>
      </p>
      <div class="mt-4 grid grid-cols-2 gap-2.5">
        <button type="button" class="btn btn-outline px-4" data-consent="ne">
          Nesutinku
        </button>
        <button type="button" class="btn btn-primary px-4" data-consent="taip">
          Sutinku
        </button>
      </div>
    </div>
  )
}

<script>
  type Tag = (...args: unknown[]) => void;
  type Fbq = Tag & { callMethod?: Tag; queue: unknown[]; push: Fbq; loaded: boolean; version: string };
  const w = window as unknown as { dataLayer?: unknown[]; gtag?: Tag; fbq?: Fbq; _fbq?: Fbq };

  const banner = document.getElementById('slapuku-langas');
  const KEY = 'slapukai';

  const read = () => {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  };
  const save = (v: string) => {
    try {
      localStorage.setItem(KEY, v);
    } catch {
      /* privatus režimas – sutikimas galios tik šiame puslapyje */
    }
  };

  const addScript = (src: string) => {
    const s = document.createElement('script');
    s.async = true;
    s.src = src;
    document.head.appendChild(s);
  };

  function loadGoogleTag(adsId: string) {
    w.dataLayer = w.dataLayer || [];
    w.gtag = function gtag() {
      // gtag.js tikisi būtent `arguments` objekto
      // eslint-disable-next-line prefer-rest-params
      w.dataLayer!.push(arguments);
    };
    w.gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
    });
    // Lankytojas sutiko – leidžiame tik konversijų matavimą (be reklamos personalizavimo ir analitikos)
    w.gtag('consent', 'update', { ad_storage: 'granted', ad_user_data: 'granted' });
    w.gtag('js', new Date());
    w.gtag('config', adsId);
    addScript(`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(adsId)}`);
  }

  /** Oficialus Meta Pixel įkėlimo kodas, tik be įterpto (inline) skripto – kad veiktų su CSP */
  function loadMetaPixel(pixelId: string) {
    if (!w.fbq) {
      const fbq = function (...args: unknown[]) {
        if (fbq.callMethod) fbq.callMethod(...args);
        else fbq.queue.push(args);
      } as Fbq;
      fbq.push = fbq;
      fbq.loaded = true;
      fbq.version = '2.0';
      fbq.queue = [];
      w.fbq = fbq;
      if (!w._fbq) w._fbq = fbq;
      addScript('https://connect.facebook.net/en_US/fbevents.js');
    }
    // Automatiniai „mygtukų paspaudimų“ įvykiai išjungti – siunčiame tik savo aiškius įvykius (žr. žemiau)
    w.fbq('set', 'autoConfig', false, pixelId);
    w.fbq('init', pixelId);
    w.fbq('track', 'PageView');
  }

  /** Atšaukus sutikimą – ištriname reklamos slapukus (ir šio domeno, ir „.domeno“ versijas) */
  function clearAdCookies() {
    const host = location.hostname;
    const apex = host.replace(/^www\./, '');
    ['_gcl_au', '_fbp', '_fbc'].forEach((name) => {
      [undefined, host, `.${apex}`].forEach((domain) => {
        document.cookie = `${name}=; Max-Age=0; path=/${domain ? `; domain=${domain}` : ''}`;
      });
    });
  }

  if (banner) {
    const { adsId, labelCall, labelLead, metaId } = banner.dataset;
    let loaded = false;

    const load = () => {
      if (loaded) return;
      loaded = true;
      if (adsId) loadGoogleTag(adsId);
      if (metaId) loadMetaPixel(metaId);
    };

    const show = () => banner.classList.remove('hidden');
    const hide = () => banner.classList.add('hidden');

    const choice = read();
    if (choice === 'taip') load();
    else if (choice !== 'ne') show();

    banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
      b.addEventListener('click', () => {
        const v = b.dataset.consent!;
        save(v);
        hide();
        if (v === 'taip') load();
        else {
          clearAdCookies();
          // Žymės jau įkeltos – perkrauname puslapį, kad jos nebeveiktų
          if (loaded) {
            w.fbq?.('consent', 'revoke');
            location.reload();
          }
        }
      }),
    );

    document.querySelectorAll('[data-cookie-settings]').forEach((el) =>
      el.addEventListener('click', (e) => {
        e.preventDefault();
        show();
        banner.querySelector<HTMLButtonElement>('[data-consent="taip"]')?.focus();
      }),
    );

    // ---- Konversijos: skambutis, žinutės ir užklausos forma (tik sutikus)
    const convert = (kind: 'call' | 'lead', meta: 'Contact' | 'Lead') => {
      if (!loaded) return;
      const label = kind === 'call' ? labelCall : labelLead;
      if (adsId && label && w.gtag) w.gtag('event', 'conversion', { send_to: `${adsId}/${label}` });
      if (metaId && w.fbq) w.fbq('track', meta);
    };

    document.addEventListener(
      'click',
      (e) => {
        const a = (e.target as Element | null)?.closest?.('a[href]');
        if (!a) return;
        const href = a.getAttribute('href') ?? '';
        if (href.startsWith('tel:')) convert('call', 'Contact');
        else if (/^(mailto:|viber:)|wa\.me\/|m\.me\//.test(href)) convert('lead', 'Contact');
      },
      { capture: true },
    );
    // Užklausos forma (ContactForm.astro) praneša apie išsiųstą žinutę
    document.addEventListener('st:uzklausa', () => convert('lead', 'Lead'));
  }
</script>
