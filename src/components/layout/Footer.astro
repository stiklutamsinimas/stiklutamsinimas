---
import { Contrast, Mail, MapPin, Phone } from '@lucide/astro';
import Logo from './Logo.astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import { features, mailHref, mapsUrl, site, telHref } from '@/config/site';
import { getServices, serviceUrl } from '@/lib/content';

const services = await getServices();
const year = new Date().getFullYear();
const pages = [
  { href: '/paslaugos', label: 'Visos paslaugos' },
  { href: '/#kaip-dirbame', label: 'Kaip dirbame' },
  { href: '/#kainos', label: 'Kainos' },
  { href: '/naujienos', label: 'Naujienos' },
  { href: '/#duk', label: 'DUK' },
  { href: '/kontaktai', label: 'Kontaktai' },
  ...(features.shop ? [{ href: '/parduotuve', label: 'Parduotuvė' }] : []),
];
---

<footer class="relative overflow-hidden bg-footer text-[#a9bfcf]">
  <div class="container-site grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
    <div class="lg:col-span-4">
      <Logo onDark width={210} />
      <p class="mt-5 max-w-sm text-[0.95rem] leading-relaxed">
        Profesionalus automobilių ir pastatų stiklų tamsinimas. Kokybiškos plėvelės ir kruopštus klijavimas – {
          site.warrantyYears
        } metų ar ilgesnė garantija. {site.appointmentNote}.
      </p>
      <ul class="mt-6 flex flex-wrap gap-2.5" aria-label="Socialiniai tinklai">
        {
          site.social.map((s) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener me"
                aria-label={`${s.name} – ${site.domain}`}
                title={s.name}
                class="grid size-10 place-items-center rounded-full bg-white/[0.06] text-white ring-1 ring-white/10 transition hover:bg-[#2ea6e3] hover:text-[#03121c]"
              >
                <SocialIcon name={s.name} size={17} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lg:col-span-3">
      <h2 class="text-xs font-bold tracking-[0.18em] text-white uppercase">Paslaugos</h2>
      <ul class="mt-5 space-y-2.5 text-[0.95rem]">
        {
          services.map((s) => (
            <li>
              <a href={serviceUrl(s.id)} class="transition hover:text-white">
                {s.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lg:col-span-2">
      <h2 class="text-xs font-bold tracking-[0.18em] text-white uppercase">Puslapis</h2>
      <ul class="mt-5 space-y-2.5 text-[0.95rem]">
        {
          pages.map((p) => (
            <li>
              <a href={p.href} class="transition hover:text-white">
                {p.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lg:col-span-3">
      <h2 class="text-xs font-bold tracking-[0.18em] text-white uppercase">Kontaktai</h2>
      <ul class="mt-5 space-y-3 text-[0.95rem]">
        <li>
          <a href={telHref} class="inline-flex items-center gap-2.5 font-semibold text-white hover:text-[#5bbdee]">
            <Phone size={16} class="text-[#5bbdee]" aria-hidden="true" />{site.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={mailHref} class="inline-flex items-center gap-2.5 break-all hover:text-white">
            <Mail size={16} class="shrink-0 text-[#5bbdee]" aria-hidden="true" />{site.email}
          </a>
        </li>
        {
          site.locations.map((loc) => (
            <li>
              <a href={mapsUrl(loc)} target="_blank" rel="noopener" class="inline-flex gap-2.5 hover:text-white">
                <MapPin size={16} class="mt-1 shrink-0 text-[#5bbdee]" aria-hidden="true" />
                <span>
                  <strong class="font-semibold text-white">{loc.city}</strong>, {loc.street}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-site flex flex-col gap-3 pt-6 pb-24 text-sm sm:flex-row sm:items-center sm:justify-between lg:pr-64 lg:pb-6">
      <p>
        © {year} {site.name} · {site.domain}
        <span class="mx-2 text-white/20">|</span>
        <a href="/privatumo-politika" class="hover:text-white">Privatumo politika</a>
      </p>
      <p class="inline-flex items-center gap-2" data-theme-note>
        <Contrast size={15} class="text-[#5bbdee]" aria-hidden="true" />
        <span>Automatinė tema: šviesi dieną, tamsi vakare</span>
      </p>
    </div>
  </div>
</footer>

<script>
  const note = document.querySelector('[data-theme-note] span');
  const tema = (window as unknown as { stTema?: { times: () => { rise: Date; set: Date } } }).stTema;
  if (note && tema) {
    const { rise, set } = tema.times();
    const f = (d: Date) => d.toLocaleTimeString('lt-LT', { hour: '2-digit', minute: '2-digit' });
    note.textContent = `Automatinė tema: šviesi nuo ${f(rise)} (saulėtekis), tamsi nuo ${f(set)} (saulėlydis)`;
  }
</script>
