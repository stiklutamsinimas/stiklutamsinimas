---
import { Mail, MapPin, MessageCircle, Phone } from '@lucide/astro';
import Logo from './Logo.astro';
import { mailHref, mapsUrl, site, telHref } from '@/config/site';
import { getServicesByCategory, serviceUrl } from '@/lib/services';

const groups = await getServicesByCategory();
const year = new Date().getFullYear();
---

<footer class="on-dark relative overflow-hidden bg-ink-950 text-ink-300">
  <div class="pointer-events-none absolute -top-40 left-1/2 h-80 w-[60rem] -translate-x-1/2 rounded-full bg-brand-600/10 blur-3xl"></div>

  <div class="container-site relative grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
    <div class="lg:col-span-4">
      <Logo />
      <p class="mt-5 max-w-sm text-[0.95rem] leading-relaxed">
        Automobilių ir pastatų stiklų tamsinimas, žibintų tamsinimas ir poliravimas, dekoratyvinės plėvelės ir reklamos
        darbai. Daugiau nei {site.experienceYears} metų patirtis, {site.warrantyYears} metų ar ilgesnė garantija.
        {site.appointmentNote}.
      </p>
      <ul class="mt-6 space-y-3 text-[0.95rem]">
        <li>
          <a href={telHref} class="inline-flex items-center gap-3 font-semibold text-white hover:text-brand-300">
            <Phone size={18} class="text-brand-400" aria-hidden="true" />{site.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={mailHref} class="inline-flex items-center gap-3 hover:text-white">
            <Mail size={18} class="text-brand-400" aria-hidden="true" />{site.email}
          </a>
        </li>
        <li class="flex gap-4">
          <a href={site.whatsapp} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-white">
            <MessageCircle size={18} class="text-[#25d366]" aria-hidden="true" />WhatsApp
          </a>
          <a href={site.viber} class="inline-flex items-center gap-2 hover:text-white">
            <MessageCircle size={18} class="text-[#a78bfa]" aria-hidden="true" />Viber
          </a>
        </li>
      </ul>
    </div>

    {
      groups.map((group) => (
        <div class="lg:col-span-2">
          <h2 class="font-display text-sm font-bold tracking-wide text-white">{group.short}</h2>
          <ul class="mt-4 space-y-2.5 text-[0.93rem]">
            {group.items.map((s) => (
              <li>
                <a href={serviceUrl(s.id)} class="hover:text-white">
                  {s.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="lg:col-span-2">
      <h2 class="font-display text-sm font-bold tracking-wide text-white">Adresai</h2>
      <ul class="mt-4 space-y-3 text-[0.93rem]">
        {
          site.locations.map((loc) => (
            <li>
              <a href={mapsUrl(loc)} target="_blank" rel="noopener" class="group flex gap-2 hover:text-white">
                <MapPin size={16} class="mt-1 shrink-0 text-brand-400" aria-hidden="true" />
                <span>
                  <span class="block font-semibold text-white">{loc.city}</span>
                  {loc.street}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="relative border-t border-white/10">
    <div class="container-site flex flex-col gap-2 py-6 text-sm text-ink-400 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.domain}. Visos teisės saugomos.</p>
      <p>
        <a href="/paslaugos" class="hover:text-white">Visos paslaugos</a>
        <span class="mx-2 text-ink-600">·</span>
        <a href="/kontaktai" class="hover:text-white">Kontaktai</a>
      </p>
    </div>
  </div>
</footer>
