---
import { ChevronDown, Menu, Phone, X } from '@lucide/astro';
import Logo from './Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { site, telHref } from '@/config/site';
import { getServicesByCategory, getPublishedPosts, serviceUrl } from '@/lib/services';

const groups = await getServicesByCategory();
const hasBlog = (await getPublishedPosts()).length > 0;
const path = Astro.url.pathname.replace(/\.html$/, '');

const dropdowns = groups.filter((g) => g.items.length > 1);
const singles = groups.filter((g) => g.items.length === 1).map((g) => g.items[0]!);

const extraLinks = [
  ...singles.map((s) => ({ href: serviceUrl(s.id), label: s.data.title })),
  ...(hasBlog ? [{ href: '/tinklarastis', label: 'Tinklaraštis' }] : []),
  { href: '/kontaktai', label: 'Kontaktai' },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-ink-950">
  <div class="container-site flex h-[4.5rem] items-center justify-between gap-6">
    <Logo />

    <nav aria-label="Pagrindinis meniu" class="hidden items-center gap-1 lg:flex">
      {
        dropdowns.map((group) => (
          <div class="nav-dropdown group relative">
            <button
              type="button"
              class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-[0.93rem] font-medium text-ink-200 transition hover:bg-white/5 hover:text-white"
              aria-expanded="false"
              aria-haspopup="true"
            >
              {group.short}
              <ChevronDown size={16} class="transition-transform duration-200 group-hover:rotate-180" aria-hidden="true" />
            </button>
            <div class="invisible absolute top-full left-1/2 w-[25rem] -translate-x-1/2 pt-3 opacity-0 transition duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 group-data-[open]:visible group-data-[open]:opacity-100">
              <div class="rounded-3xl border border-white/10 bg-ink-900/95 p-2 shadow-2xl shadow-black/40 backdrop-blur-xl">
                {group.items.map((s) => (
                  <a
                    href={serviceUrl(s.id)}
                    class:list={[
                      'flex items-start gap-3 rounded-2xl p-3 transition hover:bg-white/5',
                      path === serviceUrl(s.id) && 'bg-white/5',
                    ]}
                  >
                    <span class="mt-0.5 grid size-9 shrink-0 place-items-center rounded-xl bg-brand-500/10 text-brand-400">
                      <Icon name={s.data.icon} size={18} />
                    </span>
                    <span>
                      <span class="block text-sm font-semibold text-white">{s.data.title}</span>
                      <span class="mt-0.5 block text-[0.8rem] leading-snug text-ink-300">{s.data.excerpt}</span>
                    </span>
                  </a>
                ))}
                <a
                  href={`/paslaugos#${group.key}`}
                  class="mt-1 block rounded-2xl px-3 py-2.5 text-center text-[0.8rem] font-semibold text-brand-400 hover:bg-white/5"
                >
                  Visos paslaugos →
                </a>
              </div>
            </div>
          </div>
        ))
      }
      {
        extraLinks.map((l) => (
          <a
            href={l.href}
            class:list={[
              'rounded-full px-4 py-2 text-[0.93rem] font-medium transition hover:bg-white/5 hover:text-white',
              path === l.href ? 'text-white' : 'text-ink-200',
            ]}
            aria-current={path === l.href ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href={telHref} class="hidden items-center gap-2 rounded-full px-3 py-2 text-[0.93rem] font-semibold text-white hover:text-brand-300 xl:inline-flex">
        <Phone size={17} class="text-brand-400" aria-hidden="true" />
        {site.phoneDisplay}
      </a>
      <a href="/kontaktai#uzklausa" class="btn btn-accent hidden min-h-11 px-5 text-sm sm:inline-flex">Gauti pasiūlymą</a>

      <a
        href={telHref}
        class="grid size-11 place-items-center rounded-full border border-white/15 text-white sm:hidden"
        aria-label={`Skambinti ${site.phoneDisplay}`}
      >
        <Phone size={19} aria-hidden="true" />
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="grid size-11 place-items-center rounded-full border border-white/15 text-white lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Atidaryti meniu"
      >
        <Menu size={20} class="menu-open-icon" aria-hidden="true" />
        <X size={20} class="menu-close-icon hidden" aria-hidden="true" />
      </button>
    </div>
  </div>

  <!-- Mobilus meniu -->
  <div id="mobile-menu" class="hidden max-h-[calc(100dvh-4.5rem)] overflow-y-auto border-t border-white/10 bg-ink-950 lg:hidden">
    <nav aria-label="Mobilus meniu" class="container-site space-y-8 py-6">
      {
        groups.map((group) => (
          <div>
            <p class="eyebrow on-dark mb-3">{group.short}</p>
            <ul class="grid gap-1 sm:grid-cols-2">
              {group.items.map((s) => (
                <li>
                  <a href={serviceUrl(s.id)} class="flex items-center gap-3 rounded-2xl p-3 text-white hover:bg-white/5">
                    <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-brand-500/10 text-brand-400">
                      <Icon name={s.data.icon} size={18} />
                    </span>
                    <span class="font-medium">{s.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="flex flex-col gap-3 border-t border-white/10 pt-6 sm:flex-row">
        {hasBlog && <a href="/tinklarastis" class="btn btn-ghost-dark">Tinklaraštis</a>}
        <a href="/kontaktai" class="btn btn-ghost-dark">Kontaktai</a>
        <a href="/kontaktai#uzklausa" class="btn btn-accent">Gauti pasiūlymą</a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Mobilus meniu
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Uždaryti meniu' : 'Atidaryti meniu');
      menu.classList.toggle('hidden', !open);
      toggle.querySelector('.menu-open-icon')?.classList.toggle('hidden', open);
      toggle.querySelector('.menu-close-icon')?.classList.toggle('hidden', !open);
      document.documentElement.classList.toggle('overflow-hidden', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }

  // Išskleidžiami meniu (paspaudimui ir klaviatūrai; pelės užvedimas veikia per CSS)
  const dropdowns = document.querySelectorAll<HTMLElement>('.nav-dropdown');
  const closeAll = (except?: HTMLElement) =>
    dropdowns.forEach((d) => {
      if (d === except) return;
      d.removeAttribute('data-open');
      d.querySelector('button')?.setAttribute('aria-expanded', 'false');
    });
  dropdowns.forEach((d) => {
    const btn = d.querySelector('button');
    btn?.addEventListener('click', () => {
      const open = !d.hasAttribute('data-open');
      closeAll(d);
      d.toggleAttribute('data-open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.nav-dropdown')) closeAll();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAll();
      (document.activeElement as HTMLElement | null)?.blur();
    }
  });
</script>
