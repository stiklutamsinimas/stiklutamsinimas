---
import { ChevronDown, Menu, Phone, X } from '@lucide/astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from '@/components/ui/Icon.astro';
import { site, telHref } from '@/config/site';
import { shopVisible } from '@/lib/shop';
import CartLink from '@/components/shop/CartLink.astro';
import { getServicesByCategory, serviceUrl } from '@/lib/content';
import { cities, cityUrl } from '@/data/cities';

const groups = await getServicesByCategory();
const shop = await shopVisible();
const path = Astro.url.pathname.replace(/\.html$/, '');

const links = [
  { href: '/#kainos', label: 'Kainos' },
  // Plačiuose ekranuose – atskiras meniu punktas (siauresniuose netelpa; mobiliame meniu rodomas visada)
  { href: '/skaiciuokle', label: 'Skaičiuoklė', wide: true },
  { href: '/naujienos', label: 'Naujienos' },
  { href: '/#duk', label: 'DUK' },
  { href: '/kontaktai', label: 'Kontaktai' },
  ...(shop ? [{ href: '/parduotuve', label: 'Parduotuvė' }] : []),
];
const isActive = (href: string) => !href.includes('#') && (path === href || path.startsWith(href + '/'));
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur-xl supports-[backdrop-filter]:bg-bg/75">
  <div class="container-site flex h-[4.5rem] items-center gap-4 lg:h-20">
    <Logo class="mr-auto lg:mr-6" width={200} />

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Pagrindinis meniu">
      <div class="dropdown group relative">
        <a
          href="/paslaugos"
          class:list={[
            'inline-flex items-center gap-1 rounded-full px-3.5 py-2 text-[0.95rem] font-semibold transition hover:text-link',
            path === '/paslaugos' ? 'text-link' : 'text-text/80',
          ]}
          aria-haspopup="true"
        >
          Paslaugos <ChevronDown size={16} aria-hidden="true" class="transition group-hover:rotate-180" />
        </a>
        <div class="dropdown-panel invisible absolute top-full left-1/2 z-50 w-[46rem] -translate-x-1/2 pt-3 opacity-0 transition duration-200">
          <div class="card grid grid-cols-3 gap-6 p-6">
            {
              groups.map((g) => (
                <div>
                  <p class="mb-3 text-xs font-bold tracking-[0.16em] text-muted uppercase">{g.label}</p>
                  <ul class="space-y-1">
                    {g.items.map((s) => (
                      <li>
                        <a
                          href={serviceUrl(s.id)}
                          class="flex items-center gap-3 rounded-xl px-2 py-2 text-[0.93rem] font-semibold text-text transition hover:bg-soft hover:text-link"
                        >
                          <span class="grid size-8 shrink-0 place-items-center rounded-full bg-soft text-link">
                            <Icon name={s.data.icon} size={16} />
                          </span>
                          {s.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
            <div class="col-span-3 flex flex-wrap items-center gap-2 border-t border-border pt-4">
              <span class="mr-1 text-xs font-bold tracking-[0.16em] text-muted uppercase">Miestai:</span>
              {
                cities.map((c) => (
                  <a href={cityUrl(c.slug)} class="chip !px-3 !py-1.5 !text-xs">
                    {c.name}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'rounded-full px-3.5 py-2 text-[0.95rem] font-semibold transition hover:text-link',
              isActive(l.href) ? 'text-link' : 'text-text/80',
              'wide' in l && l.wide && 'hidden xl:inline-block',
            ]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <ThemeToggle class="hidden sm:inline-flex" />

    {shop && <CartLink compact />}

    <a href={telHref} class="btn btn-primary hidden !px-5 !py-2.5 text-sm md:inline-flex">
      <Phone size={16} aria-hidden="true" />
      {site.phoneDisplay}
    </a>

    <a href={telHref} class="grid size-11 place-items-center rounded-full bg-primary text-on-primary md:hidden" aria-label={`Skambinti ${site.phoneDisplay}`}>
      <Phone size={18} aria-hidden="true" />
    </a>
    <button
      type="button"
      class="menu-toggle grid size-11 place-items-center rounded-full border border-border bg-card text-text lg:hidden"
      aria-expanded="false"
      aria-controls="mobilus-meniu"
      aria-label="Atidaryti meniu"
    >
      <Menu size={20} class="icon-open" aria-hidden="true" />
      <X size={20} class="icon-close hidden" aria-hidden="true" />
    </button>
  </div>

  <div id="mobilus-meniu" class="mobile-menu hidden border-t border-border bg-bg lg:hidden">
    <nav class="container-site max-h-[calc(100dvh-4.5rem)] overflow-y-auto py-6" aria-label="Mobilus meniu">
      <div class="mb-6 flex items-center justify-between gap-4 sm:hidden">
        <span class="text-sm font-semibold text-muted">Tema</span>
        <ThemeToggle class="inline-flex" />
      </div>
      {
        groups.map((g) => (
          <div class="mb-5">
            <p class="mb-2 text-xs font-bold tracking-[0.16em] text-muted uppercase">{g.label}</p>
            <ul class="grid gap-1 sm:grid-cols-2">
              {g.items.map((s) => (
                <li>
                  <a href={serviceUrl(s.id)} class="flex items-center gap-3 rounded-xl px-2 py-2.5 font-semibold text-text hover:bg-soft">
                    <span class="grid size-8 shrink-0 place-items-center rounded-full bg-soft text-link">
                      <Icon name={s.data.icon} size={16} />
                    </span>
                    {s.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="mb-5">
        <p class="mb-2 text-xs font-bold tracking-[0.16em] text-muted uppercase">Miestai</p>
        <div class="flex flex-wrap gap-2">
          {
            cities.map((c) => (
              <a href={cityUrl(c.slug)} class="chip">
                {c.name}
              </a>
            ))
          }
        </div>
      </div>
      <ul class="mt-2 grid grid-cols-2 gap-2 border-t border-border pt-5">
        {
          [{ href: '/paslaugos', label: 'Visos paslaugos' }, ...links].map((l) => (
            <li>
              <a href={l.href} class="block rounded-xl px-2 py-2.5 font-semibold text-text hover:bg-soft">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .dropdown:hover .dropdown-panel,
  .dropdown:focus-within .dropdown-panel,
  .dropdown[data-open] .dropdown-panel {
    visibility: visible;
    opacity: 1;
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobilus-meniu');
  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Uždaryti meniu' : 'Atidaryti meniu');
    menu.classList.toggle('hidden', !open);
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
    document.body.classList.toggle('overflow-hidden', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
