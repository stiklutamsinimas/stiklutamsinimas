---
import { Image } from 'astro:assets';
import logoLight from '@/assets/brand/logo.png';
import logoDark from '@/assets/brand/logo-dark.png';

interface Props {
  /** Visada naudoti šviesesnę (tamsiam fonui skirtą) versiją */
  onDark?: boolean;
  class?: string;
  width?: number;
}
const { onDark = false, class: className = '', width = 210 } = Astro.props;
const alt = 'Stiklų tamsinimas – stiklutamsinimas.eu, profesionalus klijavimas';
---

<a href="/" class:list={['inline-flex shrink-0 items-center', onDark ? 'w-[210px]' : 'w-[158px] sm:w-[200px]', className]} aria-label="stiklutamsinimas.eu – pradžia">
  {
    onDark ? (
      <Image src={logoDark} alt={alt} width={width} densities={[1, 2]} loading="eager" class="h-auto w-full" />
    ) : (
      <>
        <Image src={logoLight} alt={alt} width={width} densities={[1, 2]} loading="eager" class="h-auto w-full dark:hidden" />
        <Image src={logoDark} alt={alt} width={width} densities={[1, 2]} loading="eager" class="hidden h-auto w-full dark:block" />
      </>
    )
  }
</a>
