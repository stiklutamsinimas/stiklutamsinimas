---
import { MessageCircle, Phone } from '@lucide/astro';
import { site, telHref } from '@/config/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Gaukite kainą per kelias minutes',
  text = 'Parašykite automobilio modelį arba atsiųskite langų nuotrauką – atsakysime ir pasiūlysime tinkamiausią sprendimą.',
} = Astro.props;
---

<section class="container-site py-16 lg:py-24">
  <div class="on-dark relative isolate overflow-hidden rounded-4xl bg-ink-950 px-6 py-14 sm:px-12 lg:px-16 lg:py-16">
    <div class="absolute -top-24 -right-24 -z-10 size-96 rounded-full bg-brand-500/25 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-20 -z-10 size-80 rounded-full bg-brand-700/30 blur-3xl"></div>
    <div class="grid items-center gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 class="text-3xl font-extrabold text-white sm:text-4xl">{title}</h2>
        <p class="mt-4 max-w-xl text-lg text-ink-300">{text}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row lg:justify-end">
        <a href={telHref} class="btn btn-accent">
          <Phone size={18} aria-hidden="true" />
          {site.phoneDisplay}
        </a>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-ghost-dark">
          <MessageCircle size={18} class="text-[#25d366]" aria-hidden="true" />
          Rašyti per WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
