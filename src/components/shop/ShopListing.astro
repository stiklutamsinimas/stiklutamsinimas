---
import { MessageCircle, PackageOpen, Store, Truck } from '@lucide/astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import ProductCard from './ProductCard.astro';
import CartLink from './CartLink.astro';
import { categoryUrl, shopCategories, shopUrl, type Product } from '@/lib/shop';
import { site, telHref } from '@/config/site';

interface Props {
  title: string;
  lead: string;
  products: Product[];
  /** Aktyvi kategorija (slug) arba undefined – visos */
  current?: string;
  crumbs: { name: string; url: string }[];
}
const { title, lead, products, current, crumbs } = Astro.props;

const tabs = [{ href: shopUrl, label: 'Visos prekės', active: !current }, ...shopCategories.map((c) => ({ href: categoryUrl(c.slug), label: c.name, active: current === c.slug }))];
---

<div class="container-site pt-8 pb-24">
  <div class="flex items-center justify-between gap-4">
    <Breadcrumbs items={crumbs} />
    <CartLink />
  </div>

  <header class="mt-10 max-w-3xl">
    <p class="eyebrow">Parduotuvė</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">{title}</h1>
    <p class="mt-5 text-lg leading-relaxed text-muted">{lead}</p>
  </header>

  <nav class="mt-8 flex flex-wrap gap-2" aria-label="Kategorijos">
    {
      tabs.map((t) => (
        <a href={t.href} class="chip" aria-current={t.active ? 'page' : undefined} aria-pressed={t.active ? 'true' : undefined}>
          {t.label}
        </a>
      ))
    }
  </nav>

  {
    products.length ? (
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {products.map((p, i) => (
          <li>
            <ProductCard product={p} eager={i < 4} />
          </li>
        ))}
      </ul>
    ) : (
      <div class="card mt-10 flex flex-col items-center px-6 py-16 text-center">
        <span class="icon-bubble size-16">
          <PackageOpen size={28} aria-hidden="true" />
        </span>
        <h2 class="mt-5 text-2xl">Prekes keliame</h2>
        <p class="mt-3 max-w-md text-muted">
          Netrukus čia rasite plėveles ir įrankius. Jei jau dabar ieškote konkrečios plėvelės ar įrankio – paskambinkite, patarsime ir
          užsakysime.
        </p>
        <a href={telHref} class="btn btn-primary mt-6">
          {site.phoneDisplay}
        </a>
      </div>
    )
  }

  <ul class="mt-14 grid gap-5 md:grid-cols-3">
    <li class="card flex gap-4 p-6">
      <span class="icon-bubble"><Truck size={22} aria-hidden="true" /></span>
      <div>
        <p class="font-bold text-text">Pristatymas visoje Lietuvoje</p>
        <p class="mt-1 text-sm text-muted">Į paštomatą arba kurjeriu į namus ar biurą.</p>
      </div>
    </li>
    <li class="card flex gap-4 p-6">
      <span class="icon-bubble"><Store size={22} aria-hidden="true" /></span>
      <div>
        <p class="font-bold text-text">Atsiėmimas nemokamai</p>
        <p class="mt-1 text-sm text-muted">Kupiškyje, Rokiškyje ir Panevėžyje – iš anksto susitarus.</p>
      </div>
    </li>
    <li class="card flex gap-4 p-6">
      <span class="icon-bubble"><MessageCircle size={22} aria-hidden="true" /></span>
      <div>
        <p class="font-bold text-text">Patarsime, ką rinktis</p>
        <p class="mt-1 text-sm text-muted">Plėveles klijuojame nuo {site.foundedYear} m. – žinome, kas tinka jūsų stiklui.</p>
      </div>
    </li>
  </ul>
</div>
