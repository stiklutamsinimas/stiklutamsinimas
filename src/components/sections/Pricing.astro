---
import { ArrowRight, BuildingComplex, Calculator, Car, Check, Sun } from '@lucide/astro';
import { site } from '@/config/site';
import { carPrices, formatRange } from '@/data/prices';

/** Kainos keičiamos faile src/data/prices.ts */
interface Props {
  /** Rodyti tik automobilių kainų lentelę (paslaugos puslapyje) */
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class:list={['grid items-start gap-5', !compact && 'lg:grid-cols-12']}>
  <div class:list={['card reveal overflow-hidden', !compact && 'lg:col-span-7']}>
    <div class="flex items-center gap-4 border-b border-border bg-soft/50 px-6 py-5 sm:px-8">
      <span class="icon-bubble !bg-card"><Car size={22} aria-hidden="true" /></span>
      <div>
        <h3 class="text-xl">Galinių stiklų tamsinimas</h3>
        <p class="text-sm text-muted">Galinis stiklas ir galiniai šoniniai langai</p>
      </div>
    </div>
    <table class="w-full text-left">
      <caption class="sr-only">Automobilių stiklų tamsinimo kainos pagal kėbulo tipą</caption>
      <thead class="sr-only">
        <tr><th scope="col">Kėbulo tipas</th><th scope="col">Kaina</th></tr>
      </thead>
      <tbody class="divide-y divide-border">
        {
          carPrices.map((p) => (
            <tr class="transition hover:bg-soft/40">
              <th scope="row" class="px-4 py-4 font-bold text-text sm:px-8">
                {p.type}
                {p.note && <span class="ml-2 text-sm font-medium text-muted">{p.note}</span>}
              </th>
              <td class="px-4 py-4 text-right text-lg font-extrabold whitespace-nowrap text-link tabular-nums sm:px-8">{formatRange(p)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <div class="flex flex-col gap-3 border-t border-border px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <ul class="flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-muted">
        {
          ['Darbas per 2–3 val.', site.warranty.short, 'Be burbulų'].map((t) => (
            <li class="inline-flex items-center gap-1.5">
              <Check size={16} class="text-link" aria-hidden="true" />
              {t}
            </li>
          ))
        }
      </ul>
      <a href={compact ? '#uzklausa' : '#kontaktai'} class="btn btn-primary shrink-0">Užsakyti <ArrowRight size={17} aria-hidden="true" /></a>
    </div>
  </div>

  {
    !compact && (
      <div class="grid gap-5 lg:col-span-5">
        <div class="card reveal p-7" style="transition-delay:80ms">
          <span class="icon-bubble">
            <Sun size={22} aria-hidden="true" />
          </span>
          <h3 class="mt-5 text-xl">Priekiniai stiklai</h3>
          <p class="mt-2 text-muted">Aterminės ir chameleono plėvelės priekiniam stiklui ir šoniniams langams. Kaina priklauso nuo plėvelės.</p>
          <a href="/priekiniu-stiklu-tamsinimas" class="mt-5 inline-flex items-center gap-1.5 font-bold text-link">
            Plėvelių pavyzdžiai <ArrowRight size={16} aria-hidden="true" />
          </a>
        </div>
        <div class="card reveal p-7" style="transition-delay:160ms">
          <span class="icon-bubble">
            <BuildingComplex size={22} aria-hidden="true" />
          </span>
          <h3 class="mt-5 text-xl">Langų plėvelės pastatams</h3>
          <p class="mt-2 text-muted">Veidrodinės, matinės ir dekoratyvinės plėvelės. Kaina – pagal stiklų plotą, atvykstame įvertinti.</p>
          <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
            <a href="/skaiciuokle" class="inline-flex items-center gap-1.5 font-bold text-link">
              <Calculator size={16} aria-hidden="true" /> Apskaičiuoti kainą
            </a>
            <a href="/langu-tamsinimas" class="inline-flex items-center gap-1.5 font-bold text-link">
              Plačiau <ArrowRight size={16} aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    )
  }
</div>
<p class="mt-6 text-sm text-muted">
  Kainos orientacinės – tiksli kaina priklauso nuo automobilio modelio ir pasirinktos plėvelės. Ją pasakysime iš anksto.
</p>
