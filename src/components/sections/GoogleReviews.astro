---
/**
 * Google atsiliepimai. Duomenys gaunami svetainės kūrimo metu (žr. src/lib/google-reviews.ts).
 * Jei raktas nenustatytas – rodoma nuoroda į atsiliepimus Google Maps.
 */
import { ExternalLink, PenLine, Star } from '@lucide/astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import { site } from '@/config/site';
import { getGoogleReviews } from '@/lib/google-reviews';

const data = await getGoogleReviews();
const readUrl = data?.mapsUrl ?? site.google.reviewsUrl;
const writeUrl = data?.writeUrl ?? site.google.reviewsUrl;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((p) => p[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
const stars = (n: number) => Array.from({ length: 5 }, (_, i) => i < Math.round(n));
---

{
  data ? (
    <div>
      <div class="card flex flex-col gap-6 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
        <div class="flex items-center gap-5">
          <span class="grid size-14 place-items-center rounded-2xl bg-white shadow ring-1 ring-border">
            <SocialIcon name="Google" size={28} brand />
          </span>
          <div>
            <p class="flex items-center gap-3">
              <span class="text-4xl font-extrabold text-text">{data.rating.toFixed(1).replace('.', ',')}</span>
              <span class="flex text-accent">
                {stars(data.rating).map((on) => (
                  <Star size={20} fill={on ? 'currentColor' : 'none'} aria-hidden="true" />
                ))}
              </span>
            </p>
            <p class="mt-1 text-sm text-muted">Pagal {data.count} atsiliepimų Google</p>
          </div>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={readUrl} target="_blank" rel="noopener" class="btn btn-outline">
            <ExternalLink size={17} aria-hidden="true" /> Visi atsiliepimai
          </a>
          <a href={writeUrl} target="_blank" rel="noopener" class="btn btn-primary">
            <PenLine size={17} aria-hidden="true" /> Palikti atsiliepimą
          </a>
        </div>
      </div>
      {data.reviews.length > 0 && (
        <ul class="mt-5 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {data.reviews.slice(0, 6).map((r, i) => (
            <li class="card reveal flex flex-col p-6" style={`transition-delay:${i * 70}ms`}>
              <div class="flex items-center gap-3">
                <span class="grid size-11 place-items-center rounded-full bg-soft font-extrabold text-link">{initials(r.author)}</span>
                <div class="min-w-0">
                  <p class="truncate font-bold text-text">{r.author}</p>
                  <p class="text-xs text-muted">{r.when}</p>
                </div>
              </div>
              <p class="mt-4 flex text-accent" aria-label={`Įvertinimas: ${r.rating} iš 5`}>
                {stars(r.rating).map((on) => (
                  <Star size={16} fill={on ? 'currentColor' : 'none'} aria-hidden="true" />
                ))}
              </p>
              <p class="mt-3 line-clamp-6 leading-relaxed text-muted">{r.text}</p>
            </li>
          ))}
        </ul>
      )}
      <p class="mt-4 text-xs text-muted">Atsiliepimai iš Google. Atnaujinami automatiškai.</p>
    </div>
  ) : (
    <div class="card flex flex-col items-start gap-6 p-7 sm:flex-row sm:items-center sm:justify-between sm:p-9">
      <div class="flex items-center gap-5">
        <span class="grid size-16 shrink-0 place-items-center rounded-2xl bg-white shadow ring-1 ring-border">
          <SocialIcon name="Google" size={32} brand />
        </span>
        <div>
          <p class="flex gap-0.5 text-accent">
            {[1, 2, 3, 4, 5].map(() => (
              <Star size={20} fill="currentColor" aria-hidden="true" />
            ))}
          </p>
          <p class="mt-2 text-lg font-extrabold text-text">Ką sako mūsų klientai?</p>
          <p class="mt-1 text-muted">Klientų atsiliepimus ir įvertinimus rasite mūsų Google verslo profilyje.</p>
        </div>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={readUrl} target="_blank" rel="noopener" class="btn btn-primary">
          <ExternalLink size={17} aria-hidden="true" /> Skaityti atsiliepimus
        </a>
        <a href={writeUrl} target="_blank" rel="noopener" class="btn btn-outline">
          <PenLine size={17} aria-hidden="true" /> Palikti atsiliepimą
        </a>
      </div>
    </div>
  )
}
