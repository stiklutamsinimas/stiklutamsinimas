---
/**
 * Google atsiliepimai – be jokių išorinių valdiklių ir mokesčių.
 * Duomenys: src/data/atsiliepimai.json (redaguojama per /admin → „Atsiliepimai“).
 * Jei Cloudflare nustatytas GOOGLE_PLACES_API_KEY – atsiliepimai paimami automatiškai iš Google.
 */
import { ExternalLink, PenLine, Sparkles, Star } from '@lucide/astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import { site } from '@/config/site';
import { getGoogleReviews } from '@/lib/google-reviews';
import local from '@/data/atsiliepimai.json';

const api = await getGoogleReviews();
const data = {
  rating: api?.rating ?? local.rating,
  count: api?.count ?? local.count,
  reviews: (api?.reviews.length ? api.reviews : local.reviews).slice(0, 5),
  highlights: local.highlights,
  readUrl: api?.mapsUrl ?? site.google.reviewsUrl,
  writeUrl: local.writeReviewUrl || api?.writeUrl || site.google.reviewsUrl,
};

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((p) => p[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
const stars = (n: number) => Array.from({ length: 5 }, (_, i) => i < Math.round(n));
const rating = data.rating.toFixed(1).replace('.', ',');
---

<div>
  <div class="card flex flex-col gap-6 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
    <div class="flex items-center gap-5">
      <span class="grid size-16 shrink-0 place-items-center rounded-2xl bg-white shadow ring-1 ring-border">
        <SocialIcon name="Google" size={32} brand />
      </span>
      <div>
        <p class="text-sm font-bold text-muted">Google atsiliepimai</p>
        <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
          <span class="text-4xl font-extrabold text-text">{rating}</span>
          <span class="flex text-[#fbbc04]" aria-label={`Įvertinimas ${rating} iš 5`}>
            {stars(data.rating).map((on) => <Star size={22} fill={on ? 'currentColor' : 'none'} aria-hidden="true" />)}
          </span>
          <span class="text-sm text-muted">({data.count} atsiliepimų)</span>
        </p>
      </div>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={data.readUrl} target="_blank" rel="noopener" class="btn btn-outline">
        <ExternalLink size={17} aria-hidden="true" /> Visi atsiliepimai
      </a>
      <a href={data.writeUrl} target="_blank" rel="noopener" class="btn btn-primary">
        <PenLine size={17} aria-hidden="true" /> Palikti atsiliepimą
      </a>
    </div>
  </div>

  <ul class="mt-5 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {
      data.highlights.length > 0 && (
        <li class="card reveal flex flex-col p-6">
          <div class="flex items-center gap-3">
            <span class="grid size-11 place-items-center rounded-full bg-gradient-to-br from-[#008ed2] to-[#5bbdee] text-white">
              <Sparkles size={20} aria-hidden="true" />
            </span>
            <div>
              <p class="font-bold text-text">Klientai dažniausiai mini</p>
              <p class="text-xs text-muted">Pagal {data.count} Google atsiliepimų</p>
            </div>
          </div>
          <p class="mt-4 flex text-[#fbbc04]" aria-hidden="true">
            {stars(data.rating).map((on) => <Star size={17} fill={on ? 'currentColor' : 'none'} />)}
          </p>
          <ul class="mt-3 space-y-2">
            {data.highlights.map((h) => (
              <li class="flex items-center gap-2.5 font-semibold text-text">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0 text-link" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                {h}
              </li>
            ))}
          </ul>
        </li>
      )
    }
    {
      data.reviews.map((r, i) => (
        <li class="card reveal flex flex-col p-6" style={`transition-delay:${(i + 1) * 70}ms`}>
          <div class="flex items-center gap-3">
            <span class="grid size-11 place-items-center rounded-full bg-soft font-extrabold text-link">{initials(r.author)}</span>
            <div class="min-w-0">
              <p class="truncate font-bold text-text">{r.author}</p>
              <p class="text-xs text-muted">Google naudotojas</p>
            </div>
          </div>
          <p class="mt-4 flex text-[#fbbc04]" aria-label={`Įvertinimas: ${r.rating} iš 5`}>
            {stars(r.rating).map((on) => <Star size={17} fill={on ? 'currentColor' : 'none'} aria-hidden="true" />)}
          </p>
          <p class="mt-3 line-clamp-6 flex-1 text-[1.02rem] leading-relaxed text-text">„{r.text}“</p>
          <p class="mt-5 flex items-center gap-2 text-sm text-muted">
            <SocialIcon name="Google" size={16} brand /> Paskelbta Google
          </p>
        </li>
      ))
    }
  </ul>
</div>
