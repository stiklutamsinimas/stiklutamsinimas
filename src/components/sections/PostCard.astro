---
import { ArrowRight, Newspaper } from '@lucide/astro';
import { Image } from 'astro:assets';
import { formatDate, postUrl, readingTime, type Post } from '@/lib/content';

interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
}
const { post, headingLevel: H = 'h3' } = Astro.props;
const d = post.data;
---

<a href={postUrl(post.id)} class="card card-hover group flex h-full flex-col overflow-hidden">
  <div class="relative aspect-[16/9] overflow-hidden bg-bg-2">
    {
      d.cover ? (
        <Image
          src={d.cover}
          alt={d.coverAlt ?? d.title}
          widths={[400, 640, 820]}
          sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
          class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
          layout="none"
        />
      ) : (
        <span class="grid h-full place-items-center text-link">
          <Newspaper size={40} aria-hidden="true" />
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-xs font-bold tracking-wider text-muted uppercase">
      <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time> · {readingTime(post.body ?? '')} min.
    </p>
    <H class="mt-3 text-lg leading-snug group-hover:text-link">{d.title}</H>
    <p class="mt-2.5 line-clamp-3 flex-1 text-[0.95rem] leading-relaxed text-muted">{d.description}</p>
    <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-link">
      Skaityti <ArrowRight size={16} aria-hidden="true" class="transition group-hover:translate-x-1" />
    </span>
  </div>
</a>
