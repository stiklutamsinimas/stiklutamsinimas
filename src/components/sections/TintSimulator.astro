---
/**
 * „Išbandykite tamsumą“ – interaktyvus slankiklis: parodo, kaip keičiasi vaizdas pro stiklą.
 * Dieną piešiama saulė, vakare (tamsi tema) – mėnulis ir žvaigždės.
 */
const stops = [
  { vlt: 70, tint: 0.22, glare: '~30 %', privacy: 'Minimalus', note: 'Leistina ir priekiniams langams – vaizdas beveik kaip be plėvelės.', front: true },
  { vlt: 50, tint: 0.42, glare: '~50 %', privacy: 'Nedidelis', note: 'Lengvas atspalvis – salone vėsiau, o vaizdas išlieka aiškus.', front: false },
  { vlt: 35, tint: 0.6, glare: '~65 %', privacy: 'Vidutinis', note: 'Populiariausias pasirinkimas – balansas tarp gero matomumo ir privatumo.', front: false },
  { vlt: 20, tint: 0.76, glare: '~80 %', privacy: 'Didelis', note: 'Tamsus atspalvis – iš lauko salono beveik nematyti.', front: false },
  { vlt: 5, tint: 0.92, glare: '~95 %', privacy: 'Maksimalus', note: 'Limuzino efektas – visiškas privatumas galinėje salono dalyje.', front: false },
];
const start = 2;
const s = stops[start]!;
---

<div class="tint-sim card relative overflow-hidden p-5 sm:p-7" data-stops={JSON.stringify(stops)}>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-lg font-extrabold text-text">Išbandykite tamsumą</p>
      <p class="mt-1 max-w-xs text-sm leading-relaxed text-muted">Tempkite slankiklį – pamatysite, kaip keičiasi vaizdas pro stiklą.</p>
    </div>
    <div class="text-right">
      <p class="text-3xl font-extrabold text-link tabular-nums sm:text-4xl" data-out="vlt">{s.vlt} %</p>
      <p class="text-[0.65rem] font-bold tracking-[0.18em] text-muted uppercase">Pralaidumas</p>
    </div>
  </div>

  <div class="mt-5 overflow-hidden rounded-2xl bg-gradient-to-b from-[#e3f1fa] to-[#cfe3f1] dark:from-[#0b1d2b] dark:to-[#08141e]">
    <svg viewBox="0 0 480 250" class="block h-auto w-full" role="img" aria-label="Automobilio langai su tamsinimo plėvele">
      <defs>
        <clipPath id="ts-win">
          <path d="M120 150 L176 78 Q184 68 198 68 L232 68 L232 150 Z M248 68 L294 68 Q308 68 316 78 L364 150 L248 150 Z"></path>
        </clipPath>
        <linearGradient id="ts-sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" class="[stop-color:#7cc4ee] dark:[stop-color:#0c2740]"></stop>
          <stop offset="1" class="[stop-color:#d8eefb] dark:[stop-color:#1b3d5a]"></stop>
        </linearGradient>
        <linearGradient id="ts-body" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" class="[stop-color:#ffffff] dark:[stop-color:#2b3f50]"></stop>
          <stop offset="1" class="[stop-color:#dbe6ee] dark:[stop-color:#1a2a37]"></stop>
        </linearGradient>
      </defs>

      <!-- Stogas ir rėmas -->
      <path d="M92 156 L162 62 Q174 48 196 48 L298 48 Q320 48 332 62 L394 156 Z" fill="url(#ts-body)" class="stroke-[#c3d3df] dark:stroke-[#33495b]" stroke-width="2"></path>

      <!-- Vaizdas pro langą -->
      <g clip-path="url(#ts-win)">
        <rect x="100" y="60" width="280" height="100" fill="url(#ts-sky)"></rect>
        <g class="dark:hidden">
          <circle cx="300" cy="96" r="15" fill="#f5a524"></circle>
          <circle cx="300" cy="96" r="24" fill="#f5a524" opacity="0.18"></circle>
          <ellipse cx="200" cy="92" rx="22" ry="7" fill="#fff" opacity="0.85"></ellipse>
          <ellipse cx="270" cy="114" rx="16" ry="5" fill="#fff" opacity="0.7"></ellipse>
        </g>
        <g class="hidden dark:block">
          <circle cx="302" cy="94" r="12" fill="#ffc65a"></circle>
          <circle cx="308" cy="90" r="11" fill="#0f2b44"></circle>
          <circle cx="190" cy="84" r="1.4" fill="#fff"></circle>
          <circle cx="214" cy="100" r="1" fill="#fff"></circle>
          <circle cx="262" cy="82" r="1.2" fill="#fff"></circle>
          <circle cx="335" cy="112" r="1" fill="#fff"></circle>
          <circle cx="160" cy="118" r="1.1" fill="#fff"></circle>
        </g>
        <path d="M100 140 Q150 112 205 132 T300 126 T380 134 V160 H100 Z" class="fill-[#5f9f7c] dark:fill-[#183a30]"></path>
        <path d="M100 150 Q170 130 240 146 T380 142 V160 H100 Z" class="fill-[#4b8a69] dark:fill-[#132f27]"></path>
        <!-- Keleiviai -->
        <g class="fill-[#13202b] dark:fill-[#05090d]">
          <rect x="190" y="104" width="30" height="34" rx="12"></rect>
          <rect x="178" y="130" width="54" height="30" rx="12"></rect>
          <rect x="276" y="110" width="26" height="30" rx="11"></rect>
          <rect x="266" y="134" width="46" height="26" rx="11"></rect>
        </g>
        <!-- Plėvelė -->
        <rect x="100" y="60" width="280" height="100" fill="#07131c" class="ts-tint transition-opacity duration-300" style={`opacity:${s.tint}`}></rect>
        <!-- Atspindžiai -->
        <path d="M170 160 L230 60 L246 60 L186 160 Z" fill="#fff" opacity="0.10"></path>
        <path d="M300 160 L356 60 L364 60 L308 160 Z" fill="#fff" opacity="0.08"></path>
      </g>

      <!-- Langų rėmai -->
      <path d="M120 150 L176 78 Q184 68 198 68 L232 68 L232 150 Z M248 68 L294 68 Q308 68 316 78 L364 150 L248 150 Z" fill="none" stroke="#0a1620" stroke-width="5" stroke-linejoin="round"></path>
      <rect x="232" y="64" width="16" height="92" fill="#0a1620"></rect>
      <rect x="84" y="150" width="318" height="7" rx="3.5" fill="#0a1620"></rect>

      <!-- Durys -->
      <path d="M72 157 H414 V222 Q414 234 402 234 H84 Q72 234 72 222 Z" fill="url(#ts-body)" class="stroke-[#c3d3df] dark:stroke-[#33495b]" stroke-width="2"></path>
      <line x1="240" y1="157" x2="240" y2="234" class="stroke-[#c3d3df] dark:stroke-[#33495b]" stroke-width="2"></line>
      <rect x="176" y="176" width="36" height="7" rx="3.5" class="fill-[#aebdc9] dark:fill-[#4a6273]"></rect>
      <rect x="306" y="176" width="36" height="7" rx="3.5" class="fill-[#aebdc9] dark:fill-[#4a6273]"></rect>
    </svg>
  </div>

  <div class="mt-6">
    <label class="sr-only" for="ts-range">Plėvelės pralaidumas</label>
    <input
      id="ts-range"
      type="range"
      min="0"
      max={stops.length - 1}
      step="1"
      value={start}
      class="ts-range w-full"
      aria-valuetext={`${s.vlt} % pralaidumas`}
    />
    <div class="mt-2 flex justify-between text-xs font-bold text-muted">
      {stops.map((st, i) => <span class:list={['tabular-nums', i === start && 'text-link']} data-label={i}>{st.vlt} %</span>)}
    </div>
  </div>

  <div class="mt-5 grid grid-cols-3 gap-2.5">
    <div class="rounded-xl bg-bg-2 px-3 py-2.5">
      <p class="text-[0.7rem] text-muted">Akinimo mažiau</p>
      <p class="mt-0.5 font-extrabold text-text" data-out="glare">{s.glare}</p>
    </div>
    <div class="rounded-xl bg-bg-2 px-3 py-2.5">
      <p class="text-[0.7rem] text-muted">Privatumas</p>
      <p class="mt-0.5 font-extrabold text-text" data-out="privacy">{s.privacy}</p>
    </div>
    <div class="rounded-xl bg-bg-2 px-3 py-2.5">
      <p class="text-[0.7rem] text-muted">UV apsauga</p>
      <p class="mt-0.5 font-extrabold text-text">iki 99 %</p>
    </div>
  </div>
  <p class="mt-4 text-sm leading-relaxed text-muted" data-out="note">{s.note}</p>
  <p class="mt-3 inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-bold" data-out="use">
    <span class="size-2 rounded-full bg-current"></span>
    <span data-out="use-text">Tinka galiniams langams</span>
  </p>
</div>

<style>
  .ts-range {
    appearance: none;
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(90deg, #ddeffa, #4a6273 55%, #06111a);
    cursor: pointer;
  }
  .ts-range::-webkit-slider-thumb {
    appearance: none;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--c-card);
    border: 4px solid var(--c-primary);
    box-shadow: 0 4px 14px -4px rgb(0 0 0 / 0.4);
  }
  .ts-range::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--c-card);
    border: 4px solid var(--c-primary);
  }
  [data-out='use'] {
    color: var(--c-muted);
    background: var(--c-bg-2);
  }
  [data-out='use'][data-front] {
    color: #15803d;
    background: rgb(34 197 94 / 0.12);
  }
  :global([data-theme='dark']) [data-out='use'][data-front] {
    color: #4ade80;
  }
</style>

<script>
  type Stop = { vlt: number; tint: number; glare: string; privacy: string; note: string; front: boolean };
  document.querySelectorAll<HTMLElement>('.tint-sim').forEach((root) => {
    const stops = JSON.parse(root.dataset.stops ?? '[]') as Stop[];
    const range = root.querySelector<HTMLInputElement>('.ts-range');
    const tint = root.querySelector<SVGRectElement>('.ts-tint');
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`);
    const update = () => {
      const i = Number(range?.value ?? 2);
      const s = stops[i];
      if (!s) return;
      tint?.style.setProperty('opacity', String(s.tint));
      out('vlt')!.textContent = `${s.vlt} %`;
      out('glare')!.textContent = s.glare;
      out('privacy')!.textContent = s.privacy;
      out('note')!.textContent = s.note;
      out('use-text')!.textContent = s.front ? 'Tinka ir priekiniams langams' : 'Tinka galiniams langams';
      out('use')!.toggleAttribute('data-front', s.front);
      range?.setAttribute('aria-valuetext', `${s.vlt} % pralaidumas`);
      root.querySelectorAll<HTMLElement>('[data-label]').forEach((l) => l.classList.toggle('text-link', l.dataset.label === String(i)));
    };
    range?.addEventListener('input', update);
    update();
  });
</script>
