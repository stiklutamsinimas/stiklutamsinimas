---
/** Dalinimosi mygtukai straipsniams (be trečiųjų šalių skriptų – tik nuorodos) */
import { Link2, Mail, Share2 } from '@lucide/astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';

interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const links = [
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, color: '#0866FF' },
  { name: 'WhatsApp', href: `https://wa.me/?text=${t}%20${u}`, color: '#25D366' },
  { name: 'Viber', href: `viber://forward?text=${t}%20${u}`, color: '#7360F2' },
  { name: 'X', href: `https://x.com/intent/post?url=${u}&text=${t}`, color: '#000000' },
];
const btn = 'grid size-11 place-items-center rounded-full border border-border bg-card text-text transition hover:-translate-y-0.5 hover:border-primary hover:text-link';
---

<div class="share flex flex-wrap items-center gap-2.5" data-url={url} data-title={title}>
  <span class="mr-1 text-sm font-bold text-text">Dalintis:</span>
  {
    links.map((l) => (
      <a
        href={l.href}
        target={l.name === 'Viber' ? undefined : '_blank'}
        rel="noopener nofollow"
        class={btn}
        aria-label={`Dalintis per ${l.name}`}
        title={l.name}
      >
        <SocialIcon name={l.name === 'X' ? 'X' : l.name} size={18} />
      </a>
    ))
  }
  <a href={`mailto:?subject=${t}&body=${u}`} class={btn} aria-label="Siųsti el. paštu" title="El. paštu">
    <Mail size={18} aria-hidden="true" />
  </a>
  <button type="button" class:list={[btn, 'share-copy']} aria-label="Kopijuoti nuorodą" title="Kopijuoti nuorodą">
    <Link2 size={18} aria-hidden="true" />
  </button>
  <button type="button" class:list={[btn, 'share-native hidden']} aria-label="Dalintis" title="Dalintis">
    <Share2 size={18} aria-hidden="true" />
  </button>
  <span class="share-msg text-sm font-semibold text-link" role="status"></span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.share').forEach((root) => {
    const url = root.dataset.url ?? location.href;
    const title = root.dataset.title ?? document.title;
    const msg = root.querySelector('.share-msg');
    root.querySelector('.share-copy')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        if (msg) msg.textContent = 'Nuoroda nukopijuota';
      } catch {
        if (msg) msg.textContent = url;
      }
      setTimeout(() => msg && (msg.textContent = ''), 2500);
    });
    const native = root.querySelector<HTMLButtonElement>('.share-native');
    if (native && 'share' in navigator) {
      native.classList.remove('hidden');
      native.addEventListener('click', () => navigator.share({ title, url }).catch(() => {}));
    }
  });
</script>
