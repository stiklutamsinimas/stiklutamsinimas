---
/**
 * Dalinimosi mygtukai: Facebook, Instagram, TikTok, YouTube ir nuorodos kopijavimas.
 * Facebook turi dalinimosi langą. Instagram, TikTok ir YouTube dalinimosi nuorodų neturi,
 * todėl telefone atidaromas sistemos dalinimosi meniu (ten yra šios programėlės),
 * o kompiuteryje nuoroda nukopijuojama ir atidaroma programėlės svetainė.
 */
import { Link2 } from '@lucide/astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';

interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const apps = [
  { name: 'Instagram', web: 'https://www.instagram.com/' },
  { name: 'TikTok', web: 'https://www.tiktok.com/' },
  { name: 'YouTube', web: 'https://www.youtube.com/' },
];
const btn =
  'grid size-11 place-items-center rounded-full border border-border bg-card text-text transition hover:-translate-y-0.5 hover:border-primary hover:text-link';
---

<div class="share flex flex-wrap items-center gap-2.5" data-url={url} data-title={title}>
  <span class="mr-1 text-sm font-bold text-text">Dalintis:</span>
  <a
    href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`}
    target="_blank"
    rel="noopener nofollow"
    class={btn}
    aria-label="Dalintis Facebook"
    title="Facebook"
  >
    <SocialIcon name="Facebook" size={18} />
  </a>
  {
    apps.map((a) => (
      <button type="button" class={btn} data-share-app={a.name} data-web={a.web} aria-label={`Dalintis ${a.name}`} title={a.name}>
        <SocialIcon name={a.name} size={18} />
      </button>
    ))
  }
  <button type="button" class:list={[btn, 'share-copy']} aria-label="Kopijuoti nuorodą" title="Kopijuoti nuorodą">
    <Link2 size={18} aria-hidden="true" />
  </button>
  <span class="share-msg w-full text-sm font-semibold text-link sm:w-auto" role="status"></span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.share').forEach((root) => {
    const url = root.dataset.url ?? location.href;
    const title = root.dataset.title ?? document.title;
    const msg = root.querySelector<HTMLElement>('.share-msg');
    const say = (t: string) => {
      if (!msg) return;
      msg.textContent = t;
      setTimeout(() => (msg.textContent = ''), 4000);
    };
    const copy = async () => {
      try {
        await navigator.clipboard.writeText(url);
        return true;
      } catch {
        return false;
      }
    };
    const mobile = window.matchMedia('(pointer: coarse)').matches;

    root.querySelector('.share-copy')?.addEventListener('click', async () => {
      say((await copy()) ? 'Nuoroda nukopijuota' : url);
    });
    root.querySelectorAll<HTMLButtonElement>('[data-share-app]').forEach((b) =>
      b.addEventListener('click', async () => {
        const app = b.dataset.shareApp ?? '';
        if (mobile && 'share' in navigator) {
          // Telefone – sistemos meniu, kuriame pasirenkama Instagram / TikTok / YouTube
          navigator.share({ title, url }).catch(() => {});
          return;
        }
        const ok = await copy();
        say(ok ? `Nuoroda nukopijuota – įklijuokite ją ${app}` : url);
        window.open(b.dataset.web, '_blank', 'noopener');
      }),
    );
  });
</script>
