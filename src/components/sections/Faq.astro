---
import { Plus } from '@lucide/astro';
interface Props {
  items: { q: string; a: string }[];
  /** Pirmas klausimas atidarytas */
  openFirst?: boolean;
}
const { items, openFirst = true } = Astro.props;
---

<div class="space-y-3">
  {
    items.map((item, i) => (
      <details
        class="faq group card overflow-hidden transition open:border-primary/70 open:shadow-[0_0_0_1px_var(--c-primary)]"
        open={openFirst && i === 0}
      >
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-[1.02rem] font-bold text-text sm:px-6 [&::-webkit-details-marker]:hidden">
          {item.q}
          <Plus size={20} aria-hidden="true" class="shrink-0 text-link transition duration-300 group-open:rotate-45" />
        </summary>
        <div class="px-5 pb-5 leading-relaxed text-muted sm:px-6">{item.a}</div>
      </details>
    ))
  }
</div>
