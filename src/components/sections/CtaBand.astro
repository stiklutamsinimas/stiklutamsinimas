---
import { MessageCircle, Phone } from '@lucide/astro';
import { site, telHref } from '@/config/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Norite sužinoti tikslią kainą?',
  text = 'Parašykite automobilio modelį arba langų plotą – greitai atsakysime.',
} = Astro.props;
---

<div
  class="reveal relative overflow-hidden rounded-[2rem] bg-gradient-to-r from-[#00608f] via-[#0072a9] to-[#008ed2] px-6 py-8 text-white shadow-[0_24px_50px_-24px_#0072a9] sm:px-10 lg:flex lg:items-center lg:justify-between lg:gap-8 lg:rounded-full lg:py-7"
>
  <div class="pointer-events-none absolute -top-24 -right-16 size-72 rounded-full border-[28px] border-white/[0.07]"></div>
  <div class="relative">
    <p class="text-2xl font-extrabold tracking-tight text-balance sm:text-[1.7rem]">{title}</p>
    <p class="mt-1.5 text-white/85">{text}</p>
  </div>
  <div class="relative mt-6 flex flex-wrap gap-3 lg:mt-0 lg:shrink-0">
    <a href={telHref} class="btn btn-white">
      <Phone size={18} aria-hidden="true" /> Skambinti
    </a>
    <a href={site.chat.messenger} class="btn btn-glass" data-open-chat>
      <MessageCircle size={18} aria-hidden="true" /> Rašyti žinutę
    </a>
  </div>
</div>
