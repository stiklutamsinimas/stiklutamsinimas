---
/** Prekių ženklų ikonos (Simple Icons, CC0) – įterpiamos kaip SVG, be išorinių užklausų */
import { siFacebook, siGoogle, siInstagram, siMessenger, siTiktok, siViber, siWhatsapp, siX, siYoutube } from 'simple-icons';

const icons = {
  Facebook: siFacebook,
  Instagram: siInstagram,
  TikTok: siTiktok,
  YouTube: siYoutube,
  Messenger: siMessenger,
  WhatsApp: siWhatsapp,
  Viber: siViber,
  Google: siGoogle,
  X: siX,
} as const;

interface Props {
  name: keyof typeof icons | string;
  size?: number;
  class?: string;
  /** Spalvinti prekės ženklo spalva */
  brand?: boolean;
}
const { name, size = 18, class: className, brand = false } = Astro.props;
const icon = icons[name as keyof typeof icons];
---

{
  icon && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill={brand ? `#${icon.hex === '000000' ? 'currentColor' : icon.hex}` : 'currentColor'}
      class={className}
      aria-hidden="true"
    >
      <path d={icon.path} />
    </svg>
  )
}
