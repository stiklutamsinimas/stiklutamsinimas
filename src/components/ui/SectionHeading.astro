---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  as?: 'h1' | 'h2';
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, lead, as: Tag = 'h2', align = 'left', class: className = '' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center', className]}>
  {eyebrow && <p class:list={['eyebrow', align === 'center' && 'justify-center']}>{eyebrow}</p>}
  <Tag
    class:list={[
      'mt-4 leading-[1.1]',
      Tag === 'h1' ? 'text-4xl sm:text-5xl lg:text-[3.4rem]' : 'text-3xl sm:text-4xl lg:text-[2.75rem]',
    ]}
  >
    <Fragment set:html={title} />
  </Tag>
  {lead && <p class="mt-5 text-lg leading-relaxed text-muted">{lead}</p>}
  <slot />
</div>
