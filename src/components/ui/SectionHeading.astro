---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  dark?: boolean;
  as?: 'h1' | 'h2';
  class?: string;
}

const { eyebrow, title, lead, align = 'left', dark = false, as: Tag = 'h2', class: className } = Astro.props;
---

<div class:list={[align === 'center' ? 'mx-auto max-w-3xl text-center' : 'max-w-3xl', className]}>
  {eyebrow && <p class:list={['eyebrow', dark && 'on-dark']}>{eyebrow}</p>}
  <Tag class:list={['mt-4 text-3xl font-extrabold sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]', dark && 'text-white']}>
    {title}
  </Tag>
  {lead && <p class:list={['mt-5 text-lg leading-relaxed', dark ? 'text-ink-300' : 'text-ink-500']}>{lead}</p>}
  <slot />
</div>
