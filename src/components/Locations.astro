---
import { CalendarCheck, MapPin, Navigation } from '@lucide/astro';
import { mapsUrl, site } from '@/config/site';
---

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {
    site.locations.map((loc) => (
      <li class="card flex flex-col p-6">
        <span class="grid size-11 place-items-center rounded-2xl bg-brand-50 text-brand-700">
          <MapPin size={20} aria-hidden="true" />
        </span>
        <h3 class="mt-5 text-xl font-bold">{loc.city}</h3>
        <p class="mt-1 text-ink-500">{loc.street}</p>
        <p class="mt-4 inline-flex items-center gap-2 text-sm text-ink-500">
          <CalendarCheck size={15} class="text-brand-700" aria-hidden="true" />
          Tik iš anksto susitarus
        </p>
        <a
          href={mapsUrl(loc)}
          target="_blank"
          rel="noopener"
          class="mt-auto inline-flex items-center gap-2 pt-5 text-sm font-semibold text-brand-700 hover:text-brand-800"
        >
          <Navigation size={15} aria-hidden="true" />
          Rodyti žemėlapyje
          <span class="sr-only">– {loc.city}</span>
        </a>
      </li>
    ))
  }
</ul>
