---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import { ChevronLeft, ChevronRight, X, ZoomIn } from '@lucide/astro';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  /** Kiek nuotraukų rodyti iš karto (likusios – peržiūros lange) */
  limit?: number;
  id?: string;
}

const { images, limit, id = 'galerija' } = Astro.props;

const items = await Promise.all(
  images.map(async (img) => {
    const large = await getImage({ src: img.src, width: 1600, format: 'webp', quality: 80 });
    return { ...img, large: large.src };
  }),
);
// Kompiuteryje (4 stulpeliai, pirma nuotrauka užima 2×2) rodome tiek nuotraukų,
// kad eilutės būtų pilnos. Likusios pasiekiamos per „Žiūrėti visas“.
const fitRows = (n: number) => (n >= 5 ? n - ((n - 1) % 4) : n);
const count = Math.min(limit ?? Infinity, fitRows(items.length));
const visible = items.slice(0, count);
const featured = visible.length >= 5;
---

<div class="gallery" data-gallery={id}>
  <ul class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
    {
      visible.map((img, i) => (
        <li class:list={[i === 0 && featured && 'col-span-2 row-span-2']}>
          <button
            type="button"
            class="group relative block aspect-[4/3] h-full w-full overflow-hidden rounded-2xl bg-ink-100"
            data-index={i}
            data-large={img.large}
            data-alt={img.alt}
            aria-label={`Padidinti: ${img.alt}`}
          >
            <Image
              src={img.src}
              alt={img.alt}
              widths={[360, 540, 800]}
              sizes={i === 0 && featured ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw'}
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              layout="none"
            />
            <span class="absolute inset-0 grid place-items-center bg-ink-950/0 opacity-0 transition group-hover:bg-ink-950/30 group-hover:opacity-100">
              <ZoomIn size={28} class="text-white drop-shadow" aria-hidden="true" />
            </span>
          </button>
        </li>
      ))
    }
  </ul>

  {
    items.length > visible.length && (
      <div class="mt-6 flex justify-center">
        <button type="button" class="btn btn-ghost" data-index={visible.length}>
          Žiūrėti visas nuotraukas ({items.length})
        </button>
      </div>
    )
  }

  <template data-all>
    {items.map((img) => <span data-large={img.large} data-alt={img.alt} />)}
  </template>

  <dialog class="lightbox m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-transparent" aria-label="Nuotraukų peržiūra">
    <div class="lightbox-stage relative flex h-dvh w-screen items-center justify-center p-4 sm:p-10">
      <figure class="flex max-h-full max-w-6xl flex-col items-center">
        <img class="lightbox-img max-h-[80dvh] w-auto rounded-xl object-contain shadow-2xl" src="" alt="" decoding="async" />
        <figcaption class="lightbox-caption mt-4 text-center text-sm text-ink-200"></figcaption>
      </figure>
      <button type="button" class="lightbox-close absolute top-4 right-4 grid size-12 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20" aria-label="Uždaryti">
        <X size={22} aria-hidden="true" />
      </button>
      <button type="button" class="lightbox-prev absolute top-1/2 left-3 grid size-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20 sm:left-6" aria-label="Ankstesnė nuotrauka">
        <ChevronLeft size={24} aria-hidden="true" />
      </button>
      <button type="button" class="lightbox-next absolute top-1/2 right-3 grid size-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20 sm:right-6" aria-label="Kita nuotrauka">
        <ChevronRight size={24} aria-hidden="true" />
      </button>
      <p class="lightbox-counter absolute bottom-4 left-1/2 -translate-x-1/2 text-xs font-medium tracking-widest text-ink-300"></p>
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.gallery').forEach((root) => {
    const dialog = root.querySelector('dialog');
    const img = root.querySelector<HTMLImageElement>('.lightbox-img');
    const caption = root.querySelector('.lightbox-caption');
    const counter = root.querySelector('.lightbox-counter');
    const tpl = root.querySelector<HTMLTemplateElement>('template[data-all]');
    if (!dialog || !img || !caption || !counter || !tpl) return;

    const all = Array.from(tpl.content.querySelectorAll<HTMLElement>('span')).map((s) => ({
      src: s.dataset.large ?? '',
      alt: s.dataset.alt ?? '',
    }));
    let current = 0;

    const show = (i: number) => {
      current = (i + all.length) % all.length;
      const item = all[current];
      if (!item) return;
      img.src = item.src;
      img.alt = item.alt;
      caption.textContent = item.alt;
      counter.textContent = `${current + 1} / ${all.length}`;
    };

    root.querySelectorAll<HTMLButtonElement>('button[data-index]').forEach((btn) =>
      btn.addEventListener('click', () => {
        show(Number(btn.dataset.index));
        dialog.showModal();
      }),
    );
    root.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
    root.querySelector('.lightbox-prev')?.addEventListener('click', () => show(current - 1));
    root.querySelector('.lightbox-next')?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as Element).classList.contains('lightbox-stage')) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // Braukimas telefone
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0]?.clientX ?? 0), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = (e.changedTouches[0]?.clientX ?? 0) - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });
  });
</script>
