---
/**
 * Paslaugų ir straipsnių puslapiai – visi šakniniame lygyje, kaip senoje svetainėje
 * (pvz. /langu-tamsinimas, /kaip-tamsinti-automobilio-stiklus), kad nebūtų prarastos Google pozicijos.
 */
import type { GetStaticPaths } from 'astro';
import ServicePage from '@/components/pages/ServicePage.astro';
import ArticlePage from '@/components/pages/ArticlePage.astro';
import { getPosts, getServices, type Post, type Service } from '@/lib/content';

export const getStaticPaths = (async () => {
  const services = await getServices();
  const posts = await getPosts();
  const reserved = new Set(['paslaugos', 'kontaktai', 'naujienos', 'parduotuve', 'admin', 'privatumo-politika', '404', 'rss']);
  const seen = new Set<string>();
  for (const id of [...services.map((s) => s.id), ...posts.map((p) => p.id)]) {
    if (reserved.has(id) || seen.has(id) || id.startsWith('stiklu-tamsinimas-')) {
      throw new Error(`Adresas „/${id}“ jau užimtas – pervadinkite failą src/content/.../${id}.md`);
    }
    seen.add(id);
  }
  return [
    ...services.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'service' as const, entry } })),
    ...posts.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'post' as const, entry } })),
  ];
}) satisfies GetStaticPaths;

type Props = { kind: 'service'; entry: Service } | { kind: 'post'; entry: Post };
const props = Astro.props as Props;
---

{props.kind === 'service' ? <ServicePage entry={props.entry} /> : <ArticlePage entry={props.entry} />}
