---
/**
 * Miesto puslapis: /stiklu-tamsinimas-vilnius, -panevezys, -kupiskis, -rokiskis, -kaunas.
 * Duomenys – src/data/cities.ts
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { ArrowRight, CalendarCheck, MapPin, MessageCircle, Navigation, Phone, ShieldCheck, Truck } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import Pricing from '@/components/sections/Pricing.astro';
import Gallery from '@/components/sections/Gallery.astro';
import Steps from '@/components/sections/Steps.astro';
import Faq from '@/components/sections/Faq.astro';
import GoogleReviews from '@/components/sections/GoogleReviews.astro';
import ContactForm from '@/components/sections/ContactForm.astro';
import ContactInfo from '@/components/sections/ContactInfo.astro';
import { mapsEmbedUrl, mapsUrl, site, telHref } from '@/config/site';
import { cities, cityAnchor, cityUrl, type City } from '@/data/cities';
import { image } from '@/data/galleries';
import { getServices, serviceUrl } from '@/lib/content';
import { breadcrumbSchema, cityServiceSchema, faqSchema } from '@/lib/schema';

export const getStaticPaths = (() => cities.map((city) => ({ params: { miestas: city.slug }, props: { city } }))) satisfies GetStaticPaths;

interface Props {
  city: City;
}
const { city } = Astro.props;
const loc = site.locations.find((l) => l.city === city.location);
const all = await getServices();
const services = city.services.map((id) => all.find((s) => s.id === id)).filter((s): s is NonNullable<typeof s> => Boolean(s));
const others = cities.filter((c) => c.slug !== city.slug);
const url = cityUrl(city.slug);

const md = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
const crumbs = [
  { name: 'Pradžia', url: '/' },
  { name: 'Paslaugos', url: '/paslaugos' },
  { name: cityAnchor(city), url },
];
const schema = [cityServiceSchema(city, url), breadcrumbSchema(crumbs), faqSchema(city.faq)];
const galleryImages = city.gallery.map(image);
---

<BaseLayout title={city.seoTitle} description={city.seoDescription} image={galleryImages[0]?.src} imageAlt={galleryImages[0]?.alt} schema={schema}>
  <!-- Įvadas -->
  <section class="relative isolate overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -top-48 -right-48 size-[40rem] rounded-full border-[56px] border-logo/[0.06]"></div>
      <div class="absolute top-1/3 -left-48 size-[28rem] rounded-full bg-logo/[0.07] blur-3xl"></div>
    </div>
    <div class="container-site pt-8 pb-16 lg:pt-10 lg:pb-24">
      <Breadcrumbs items={crumbs} />
      <div class="mt-10 grid items-center gap-12 lg:grid-cols-12">
        <div class="animate-fade-up lg:col-span-6">
          <p class="eyebrow">{city.name}</p>
          <h1 class="mt-5 text-4xl leading-[1.08] sm:text-5xl lg:text-[3.3rem]">
            {city.keyword} <span class="text-link">{city.nameIn}</span>
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-muted">{city.lead}</p>
          <p class="mt-6 inline-flex items-center gap-2 rounded-full bg-soft px-4 py-2 font-bold text-text">
            {loc ? <MapPin size={18} class="text-link" aria-hidden="true" /> : <Truck size={18} class="text-link" aria-hidden="true" />}
            {loc ? `${loc.street}, ${loc.city}` : `Atvykstame pas jus – ${city.name}`}
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={telHref} class="btn btn-primary !px-6 !py-3.5"><Phone size={18} aria-hidden="true" /> {site.phoneDisplay}</a>
            <a href={site.chat.messenger} class="btn btn-outline !px-6 !py-3.5" data-open-chat>
              <MessageCircle size={18} aria-hidden="true" /> Rašyti žinutę
            </a>
          </div>
          <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
            <span class="inline-flex items-center gap-1.5"><ShieldCheck size={16} class="text-link" aria-hidden="true" /> {site.warranty.short}</span>
            <span class="inline-flex items-center gap-1.5"><CalendarCheck size={16} class="text-link" aria-hidden="true" /> Tik iš anksto susitarus</span>
          </p>
        </div>
        <div class="animate-fade-up [animation-delay:120ms] lg:col-span-6">
          {
            loc ? (
              <div class="card overflow-hidden">
                <div class="relative aspect-[4/3] bg-bg-2">
                  <iframe
                    src={mapsEmbedUrl(loc)}
                    title={`Žemėlapis: ${loc.street}, ${loc.city}`}
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    class="absolute inset-0 h-full w-full border-0 dark:[filter:invert(0.9)_hue-rotate(180deg)_brightness(0.95)_contrast(0.9)]"
                    allowfullscreen
                  />
                </div>
                <div class="flex items-center justify-between gap-4 p-5">
                  <div>
                    <p class="font-extrabold text-text">{loc.street}</p>
                    <p class="text-sm text-muted">{loc.city} · tik iš anksto susitarus</p>
                  </div>
                  <a href={mapsUrl(loc)} target="_blank" rel="noopener" class="btn btn-outline shrink-0 !px-4 !py-2.5 text-sm">
                    <Navigation size={16} aria-hidden="true" /> Maršrutas
                  </a>
                </div>
              </div>
            ) : (
              galleryImages[0] && (
                <div class="overflow-hidden rounded-[1.75rem] border border-border shadow-[0_30px_60px_-30px_rgb(var(--c-shadow)/0.45)]">
                  <Image src={galleryImages[0].src} alt={galleryImages[0].alt} widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 580px, 100vw" class="aspect-[4/3] w-full object-cover" loading="eager" fetchpriority="high" layout="none" />
                </div>
              )
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Apie -->
  <section class="section bg-bg-2">
    <div class="container-site grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading eyebrow={city.name} title={city.cars ? `Automobilių ir langų tamsinimas ${city.nameIn}` : `Plėvelės pastatams ${city.nameIn}`} />
      </div>
      <div class="prose-site lg:col-span-7">
        {city.intro.map((p) => <p set:html={md(p)} />)}
        <p>
          Dirbame nuo {site.foundedYear} m. ir naudojame tik kokybiškas {site.filmBrands.join(', ')} plėveles. {site.appointmentNote} – paskambinkite{' '}
          <a href={telHref}>{site.phoneDisplay}</a> arba parašykite.
        </p>
        <h3>{city.areas.length ? `Aptarnaujame ir ${city.nameOf} rajoną` : `Kur dirbame`}</h3>
        <p>{city.areasText}</p>
        {city.areas.length > 0 && (
          <ul class="!mt-4 flex !list-none flex-wrap gap-2 !pl-0">
            {city.areas.map((a) => (
              <li class="inline-flex items-center gap-1.5 rounded-full border border-border bg-card px-3 py-1.5 text-sm font-semibold text-text">
                <MapPin size={14} class="text-link" aria-hidden="true" /> {a}
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>

  <!-- Paslaugos -->
  <section id="paslaugos" class="section">
    <div class="container-site">
      <SectionHeading eyebrow="Paslaugos" title={`Ką atliekame ${city.nameIn}`} />
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s, i) => (
            <li class="reveal" style={`transition-delay:${(i % 3) * 60}ms`}>
              <a href={serviceUrl(s.id)} class="card card-hover group flex h-full gap-4 p-5">
                <span class="icon-bubble">
                  <Icon name={s.data.icon} />
                </span>
                <span class="min-w-0">
                  <span class="block font-bold text-text group-hover:text-link">
                    {s.data.title} {city.nameIn}
                  </span>
                  <span class="mt-1 block text-sm leading-relaxed text-muted">{s.data.excerpt}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Kainos -->
  <section id="kainos" class="section bg-bg-2">
    <div class="container-site">
      {city.cars ? (
        <>
          <SectionHeading eyebrow="Kainos" title={`Automobilio stiklų tamsinimo kaina ${city.nameIn}`} lead="Kainos pagal kėbulo tipą – tokios pačios Kupiškyje, Rokiškyje ir Panevėžyje." />
          <div class="mt-10"><Pricing /></div>
        </>
      ) : (
        <div class="card reveal flex flex-col gap-6 p-7 sm:p-9 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-2xl">
            <p class="eyebrow">Kainos</p>
            <h2 class="mt-4 text-3xl">Langų tamsinimo kaina {city.nameIn}</h2>
            <p class="mt-3 text-lg leading-relaxed text-muted">Kaina priklauso nuo stiklų ploto, plėvelės rūšies ir darbo sąlygų. Atsiųskite langų nuotraukas ar matmenis – pateiksime pasiūlymą iš anksto, arba atvyksime įvertinti.</p>
          </div>
          <a href="#uzklausa" class="btn btn-primary shrink-0">Gauti pasiūlymą <ArrowRight size={18} aria-hidden="true" /></a>
        </div>
      )}
    </div>
  </section>

  <!-- Darbai -->
  <section class="section">
    <div class="container-site">
      <SectionHeading eyebrow="Atlikti darbai" title="Mūsų darbų pavyzdžiai" />
      <div class="mt-10"><Gallery groups={[{ id: 'darbai', title: 'Darbai', images: galleryImages }]} limit={9} /></div>
    </div>
  </section>

  <!-- Eiga -->
  <section class="section bg-bg-2">
    <div class="container-site">
      <SectionHeading eyebrow="Kaip dirbame" title="Nuo skambučio iki rezultato" />
      <div class="mt-12"><Steps /></div>
    </div>
  </section>

  <!-- DUK -->
  <section class="section">
    <div class="container-site grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading eyebrow="DUK" title={`Dažni klausimai – ${city.name}`} />
      </div>
      <div class="lg:col-span-7"><Faq items={city.faq} /></div>
    </div>
  </section>

  <!-- Atsiliepimai -->
  <section class="section bg-bg-2">
    <div class="container-site">
      <SectionHeading eyebrow="Atsiliepimai" title="Klientų atsiliepimai Google" />
      <div class="mt-10"><GoogleReviews /></div>
    </div>
  </section>

  <!-- Kiti miestai -->
  <section class="section !py-14">
    <div class="container-site">
      <h2 class="text-2xl">Dirbame ir kituose miestuose</h2>
      <ul class="mt-6 flex flex-wrap gap-2.5">
        {
          others.map((c) => (
            <li>
              <a href={cityUrl(c.slug)} class="chip">
                <MapPin size={15} aria-hidden="true" /> {cityAnchor(c)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Užklausa -->
  <section id="uzklausa" class="section bg-bg-2">
    <div class="container-site grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading eyebrow="Užklausa" title={`Gaukite pasiūlymą – ${city.name}`} lead={city.cars ? 'Parašykite automobilio modelį ar langų plotą – greitai atsakysime.' : 'Parašykite, kokius langus norite tamsinti, ir apytikslį jų plotą – greitai atsakysime.'} />
        <ContactInfo />
      </div>
      <div class="lg:col-span-7"><ContactForm city={city.location ?? city.name} selected={city.cars ? undefined : 'langu-tamsinimas'} /></div>
    </div>
  </section>

  <div class="container-site pb-16">
    <a href="/paslaugos" class="inline-flex items-center gap-1.5 font-bold text-link">Visos paslaugos <ArrowRight size={16} aria-hidden="true" /></a>
  </div>
</BaseLayout>
