---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getServicesByCategory } from '@/lib/services';
import { breadcrumbSchema } from '@/lib/schema';

const groups = await getServicesByCategory();
const crumbs = [
  { name: 'Pradžia', url: '/' },
  { name: 'Paslaugos', url: '/paslaugos' },
];
---

<BaseLayout
  title="Stiklų tamsinimo paslaugos | stiklutamsinimas.eu"
  description="Visos mūsų paslaugos: automobilių ir pastatų stiklų tamsinimas, žibintų tamsinimas ir poliravimas, stiklų keitimas, dekoravimas, stiklo pertvaros ir reklama."
  schema={[breadcrumbSchema(crumbs)]}
>
  <section class="on-dark relative isolate overflow-hidden bg-ink-950">
    <div class="absolute -top-40 -right-40 -z-10 size-[36rem] rounded-full bg-brand-600/20 blur-3xl"></div>
    <div class="container-site pt-8 pb-16 lg:pt-10 lg:pb-20">
      <Breadcrumbs items={crumbs} />
      <div class="reveal mt-10">
        <SectionHeading
          as="h1"
          eyebrow="Paslaugos"
          title="Viskas, kas susiję su stiklu ir plėvelėmis"
          lead="Tamsiname, saugome, dekoruojame ir keičiame stiklus – automobiliams, namams ir verslui."
          dark
        />
        <nav aria-label="Paslaugų kategorijos" class="mt-8 flex flex-wrap gap-2">
          {
            groups.map((g) => (
              <a href={`#${g.key}`} class="rounded-full border border-white/15 px-4 py-2 text-sm font-medium text-ink-200 hover:border-white/40 hover:text-white">
                {g.short}
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </section>

  {
    groups.map((group, gi) => (
      <section id={group.key} class:list={['py-20 lg:py-24', gi % 2 === 1 && 'bg-ink-50']}>
        <div class="container-site">
          <SectionHeading eyebrow={group.short} title={group.title} lead={group.description} />
          <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((s) => (
              <ServiceCard service={s} headingLevel="h3" />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <CtaBand />
</BaseLayout>
