---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ServiceCard from '@/components/sections/ServiceCard.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { getServicesByCategory } from '@/lib/content';
import { breadcrumbSchema } from '@/lib/schema';

const groups = await getServicesByCategory();
const crumbs = [
  { name: 'Pradžia', url: '/' },
  { name: 'Paslaugos', url: '/paslaugos' },
];
---

<BaseLayout
  title="Paslaugos – stiklų tamsinimas, plėvelės, reklama | stiklutamsinimas.eu"
  description="Automobilių ir pastatų stiklų tamsinimas, žibintų tamsinimas ir poliravimas, matinės, veidrodinės ir apsauginės plėvelės, reklamos darbai."
  schema={[breadcrumbSchema(crumbs)]}
>
  <section class="relative isolate overflow-hidden">
    <div class="pointer-events-none absolute -top-48 -right-48 -z-10 size-[40rem] rounded-full border-[56px] border-logo/[0.06]"></div>
    <div class="container-site pt-8 pb-6">
      <Breadcrumbs items={crumbs} />
      <SectionHeading
        as="h1"
        eyebrow="Paslaugos"
        title="Ką klijuojame"
        lead="Dirbame su automobiliais, namais, biurais ir komercinėmis patalpomis. Padėsime išsirinkti plėvelę, kuri tinka būtent jums."
        class="mt-10"
      />
    </div>
  </section>

  {
    groups.map((g, i) => (
      <section class:list={['section !pt-14', i % 2 === 1 && 'bg-bg-2']}>
        <div class="container-site">
          <h2 class="text-2xl sm:text-3xl">{g.label}</h2>
          <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((s) => (
              <li class="reveal">
                <ServiceCard service={s} photo />
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="section">
    <div class="container-site"><CtaBand /></div>
  </section>
</BaseLayout>
