---
/**
 * INTERNETINĖ PARDUOTUVĖ – paruošta, bet išjungta.
 * Įjungimas: src/config/site.ts → features.shop = true ir src/content/produktai/*.md failuose draft: false.
 * Kol išjungta – šie puslapiai visai negeneruojami (nėra nei adreso, nei nuorodų).
 * Krepšelį ir apmokėjimą (pvz. Stripe, Paysera) galima pridėti vėliau.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { features } from '@/config/site';

export const getStaticPaths = (async () => {
  if (!features.shop) return [];
  const products = await getCollection('produktai', ({ data }) => !data.draft);
  return [
    { params: { slug: undefined }, props: { products, product: undefined } },
    ...products.map((p) => ({ params: { slug: p.id }, props: { products, product: p } })),
  ];
}) satisfies GetStaticPaths;

interface Props {
  products: CollectionEntry<'produktai'>[];
  product?: CollectionEntry<'produktai'>;
}
const { products, product } = Astro.props;
const price = (n: number) => new Intl.NumberFormat('lt-LT', { style: 'currency', currency: 'EUR' }).format(n);
---

<BaseLayout
  title={product ? `${product.data.title} | Parduotuvė` : 'Parduotuvė | stiklutamsinimas.eu'}
  description={product?.data.description ?? 'Plėvelės ir priemonės stiklams.'}
>
  <div class="container-site pt-8 pb-24">
    <Breadcrumbs items={[{ name: 'Pradžia', url: '/' }, { name: 'Parduotuvė', url: '/parduotuve' }, ...(product ? [{ name: product.data.title, url: `/parduotuve/${product.id}` }] : [])]} />
    {
      product ? (
        <div class="mt-10 grid gap-10 lg:grid-cols-2">
          <Image src={product.data.images[0]!} alt={product.data.title} class="card w-full" widths={[480, 800]} sizes="(min-width:1024px) 50vw, 100vw" layout="none" />
          <div>
            <h1 class="text-4xl">{product.data.title}</h1>
            <p class="mt-4 text-3xl font-extrabold text-link">{price(product.data.price)}</p>
            <p class="mt-6 text-muted">{product.data.description}</p>
          </div>
        </div>
      ) : (
        <>
          <SectionHeading as="h1" eyebrow="Parduotuvė" title="Plėvelės ir priemonės" class="mt-10" />
          <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {products.map((p) => (
              <li>
                <a href={`/parduotuve/${p.id}`} class="card card-hover block overflow-hidden">
                  <Image src={p.data.images[0]!} alt={p.data.title} class="aspect-square w-full object-cover" widths={[320, 480]} sizes="25vw" layout="none" />
                  <div class="p-5">
                    <p class="font-bold">{p.data.title}</p>
                    <p class="mt-1 font-extrabold text-link">{price(p.data.price)}</p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</BaseLayout>
