---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getServices, serviceUrl } from '@/lib/services';

const services = await getServices();
---

<BaseLayout title="Puslapis nerastas | stiklutamsinimas.eu" description="Tokio puslapio nėra. Peržiūrėkite mūsų paslaugas arba susisiekite." noindex>
  <section class="on-dark relative isolate overflow-hidden bg-ink-950">
    <div class="absolute -top-40 -right-40 -z-10 size-[36rem] rounded-full bg-brand-600/20 blur-3xl"></div>
    <div class="container-site py-24 lg:py-32">
      <p class="font-display text-8xl font-extrabold text-brand-500/40">404</p>
      <h1 class="mt-4 text-4xl font-extrabold text-white sm:text-5xl">Puslapis nerastas</h1>
      <p class="mt-5 max-w-xl text-lg text-ink-300">
        Galbūt puslapis buvo perkeltas. Pasirinkite paslaugą žemiau arba grįžkite į pradžią.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-accent">Į pradžią</a>
        <a href="/kontaktai" class="btn btn-ghost-dark">Kontaktai</a>
      </div>
    </div>
  </section>
  <section class="container-site py-16">
    <h2 class="text-2xl font-bold">Mūsų paslaugos</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <li>
            <a href={serviceUrl(s.id)} class="card flex items-center justify-between gap-4 p-5 font-semibold text-ink-900 hover:text-brand-700">
              {s.data.title}
              <ArrowRight size={18} aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
