---
import { ArrowRight, Phone } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceCard from '@/components/sections/ServiceCard.astro';
import { site, telHref } from '@/config/site';
import { getServices } from '@/lib/content';

const featured = (await getServices()).filter((s) => s.data.featured).slice(0, 3);
---

<BaseLayout title="Puslapis nerastas | stiklutamsinimas.eu" description="Tokio puslapio nėra. Grįžkite į pradžią arba peržiūrėkite mūsų paslaugas." noindex>
  <section class="container-site py-20 text-center lg:py-28">
    <p class="text-7xl font-extrabold text-link">404</p>
    <h1 class="mt-4 text-3xl sm:text-4xl">Puslapis nerastas</h1>
    <p class="mx-auto mt-4 max-w-lg text-lg text-muted">Galbūt adresas pasikeitė. Pažiūrėkite mūsų paslaugas arba susisiekite.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Į pradžią <ArrowRight size={18} aria-hidden="true" /></a>
      <a href={telHref} class="btn btn-outline"><Phone size={18} aria-hidden="true" /> {site.phoneDisplay}</a>
    </div>
  </section>
  <section class="container-site pb-24">
    <ul class="grid gap-5 md:grid-cols-3">
      {
        featured.map((s) => (
          <li>
            <ServiceCard service={s} photo />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
