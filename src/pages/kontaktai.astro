---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ContactInfo from '@/components/sections/ContactInfo.astro';
import ContactForm from '@/components/sections/ContactForm.astro';
import Locations from '@/components/sections/Locations.astro';
import GoogleReviews from '@/components/sections/GoogleReviews.astro';
import InstagramFeed from '@/components/sections/InstagramFeed.astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import { site } from '@/config/site';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Pradžia', url: '/' },
  { name: 'Kontaktai', url: '/kontaktai' },
];
---

<BaseLayout
  title="Kontaktai – stiklų tamsinimas | stiklutamsinimas.eu"
  description={`Susisiekite: ${site.phoneDisplay}, ${site.email}, Messenger, WhatsApp ar Viber. Automobilių tamsinimas Kupiškyje, Rokiškyje ir Panevėžyje, plėvelės pastatams – ir Vilniuje bei Kaune.`}
  schema={[breadcrumbSchema(crumbs)]}
>
  <section class="relative isolate overflow-hidden">
    <div class="pointer-events-none absolute -top-48 -right-48 -z-10 size-[40rem] rounded-full border-[56px] border-logo/[0.06]"></div>
    <div class="container-site pt-8 pb-20">
      <Breadcrumbs items={crumbs} />
      <div class="mt-10 grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <SectionHeading
            as="h1"
            eyebrow="Kontaktai"
            title="Susisiekite"
            lead="Paskambinkite, parašykite arba užpildykite formą – pateiksime pasiūlymą ir suderinsime laiką. Darbai atliekami tik iš anksto susitarus."
          />
          <ContactInfo />
          <ul class="mt-6 flex flex-wrap gap-2" aria-label="Socialiniai tinklai">
            {
              site.social.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener me" class="chip">
                    <SocialIcon name={s.name} size={16} /> {s.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div id="uzklausa" class="lg:col-span-7"><ContactForm /></div>
      </div>
    </div>
  </section>

  <section id="adresai" class="section bg-bg-2">
    <div class="container-site">
      <SectionHeading eyebrow="Adresai" title="Kur mus rasti" lead="Keturi miestai – darbus atliekame tik iš anksto susitarus, todėl prieš atvykdami paskambinkite." />
      <div class="mt-10"><Locations /></div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <SectionHeading eyebrow="Atsiliepimai" title="Klientų atsiliepimai Google" />
      <div class="mt-10"><GoogleReviews /></div>
    </div>
  </section>

  <section id="instagram" class="section bg-bg-2">
    <div class="container-site">
      <SectionHeading eyebrow="Instagram" title="Naujausi darbai mūsų Instagram" class="mb-10" />
      <InstagramFeed />
    </div>
  </section>
</BaseLayout>
