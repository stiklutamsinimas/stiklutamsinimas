---
/** Tinklaraščio įrašas (/tinklarastis/<failo-pavadinimas>). */
import { Image, getImage } from 'astro:assets';
import { getEntries, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site } from '@/config/site';
import { getPublishedPosts } from '@/lib/services';
import { ORG_ID, breadcrumbSchema } from '@/lib/schema';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const services = await getEntries(data.services);

const url = `/tinklarastis/${post.id}`;
const crumbs = [
  { name: 'Pradžia', url: '/' },
  { name: 'Tinklaraštis', url: '/tinklarastis' },
  { name: data.title, url },
];
const fmt = new Intl.DateTimeFormat('lt-LT', { year: 'numeric', month: 'long', day: 'numeric' });
const shareImage = data.cover
  ? await getImage({ src: data.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 })
  : undefined;

const article = {
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  inLanguage: 'lt-LT',
  mainEntityOfPage: new URL(url, site.url).href,
  author: { '@id': ORG_ID },
  publisher: { '@id': ORG_ID },
  ...(shareImage ? { image: new URL(shareImage.src, site.url).href } : {}),
};
---

<BaseLayout
  title={data.seoTitle ?? `${data.title} | stiklutamsinimas.eu`}
  description={data.description}
  image={data.cover}
  imageAlt={data.coverAlt}
  type="article"
  schema={[article, breadcrumbSchema(crumbs)]}
>
  <article>
    <header class="on-dark bg-ink-950">
      <div class="container-site max-w-4xl pt-8 pb-14 lg:pt-10 lg:pb-20">
        <Breadcrumbs items={crumbs} />
        <time datetime={data.pubDate.toISOString()} class="mt-10 block text-sm text-ink-400">{fmt.format(data.pubDate)}</time>
        <h1 class="mt-3 text-4xl font-extrabold text-white sm:text-5xl">{data.title}</h1>
        <p class="mt-5 text-lg text-ink-300">{data.description}</p>
      </div>
    </header>

    {
      data.cover && (
        <div class="container-site -mt-6 max-w-5xl">
          <Image
            src={data.cover}
            alt={data.coverAlt ?? ''}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 64rem, 100vw"
            class="aspect-[16/9] w-full rounded-4xl object-cover shadow-xl"
            layout="none"
            priority
          />
        </div>
      )
    }

    <div class="container-site max-w-3xl py-14 lg:py-20">
      <div class="prose-site">
        <Content />
      </div>
    </div>
  </article>

  {
    services.length > 0 && (
      <section class="bg-ink-50 py-16 lg:py-24">
        <div class="container-site">
          <h2 class="text-3xl font-extrabold">Susijusios paslaugos</h2>
          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {services.map((s) => (
              <ServiceCard service={s} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>
