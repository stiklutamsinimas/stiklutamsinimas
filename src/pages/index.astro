---
import { ArrowRight, CircleCheck } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import TintSimulator from '@/components/sections/TintSimulator.astro';
import Benefits from '@/components/sections/Benefits.astro';
import ServiceCard from '@/components/sections/ServiceCard.astro';
import Gallery from '@/components/sections/Gallery.astro';
import Steps from '@/components/sections/Steps.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import Pricing from '@/components/sections/Pricing.astro';
import GoogleReviews from '@/components/sections/GoogleReviews.astro';
import InstagramFeed from '@/components/sections/InstagramFeed.astro';
import PostCard from '@/components/sections/PostCard.astro';
import Faq from '@/components/sections/Faq.astro';
import ContactInfo from '@/components/sections/ContactInfo.astro';
import ContactForm from '@/components/sections/ContactForm.astro';
import { site } from '@/config/site';
import { getFolder } from '@/data/galleries';
import { cities, cityUrl } from '@/data/cities';
import { getPosts, getServices, serviceUrl } from '@/lib/content';
import { faqSchema } from '@/lib/schema';
import { homeFaq } from '@/data/faq';

const services = await getServices();
const featured = services.filter((s) => s.data.featured);
const other = services.filter((s) => !s.data.featured);
const posts = (await getPosts()).slice(0, 3);

const benefits = [
  { icon: 'sun', title: 'Iki 99 % UV apsaugos', text: 'Sulaiko žalingus UV spindulius – oda apsaugota, o salonas ir baldai neblunka.', accent: true },
  { icon: 'thermometer', title: 'Iki 60 % mažiau šilumos', text: 'Vasarą viduje vėsiau, o kondicionierius dirba mažiau ir naudoja mažiau energijos.' },
  { icon: 'eye-off', title: 'Daugiau privatumo', text: 'Iš lauko nesimato, kas viduje – nei keleivių, nei vertingų daiktų.' },
  { icon: 'shield-check', title: 'Saugesnis stiklas', text: 'Sudužęs stiklas lieka ant plėvelės, todėl šukės nesubyra ir nesužeidžia.' },
] as const;

const workGroups = [
  { id: 'auto', title: 'Automobiliai', images: getFolder('darbai') },
  { id: 'zibintai', title: 'Žibintai', images: [...getFolder('zibintai'), ...getFolder('poliravimas')] },
  { id: 'veidrodines', title: 'Veidrodinės plėvelės', images: getFolder('veidrodines') },
  { id: 'matines', title: 'Matinės plėvelės', images: getFolder('matines') },
  { id: 'dekoravimas', title: 'Stiklų dekoravimas', images: getFolder('dekoravimas') },
  { id: 'reklama', title: 'Reklama', images: [...getFolder('reklama/lipdukai'), ...getFolder('reklama/spauda')] },
];

const faq = homeFaq;
---

<BaseLayout
  title="Automobilių ir langų stiklų tamsinimas | stiklutamsinimas.eu"
  description="Automobilių stiklų tamsinimas Kupiškyje, Rokiškyje ir Panevėžyje – nuo 90 €, 5–10 m. garantija. Langų plėvelės pastatams visoje Lietuvoje."
  schema={[faqSchema(faq)]}
>
  <!-- ===== Įvadas ===== -->
  <section class="relative isolate overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -top-40 -right-40 size-[44rem] rounded-full border-[64px] border-logo/[0.06]"></div>
      <div class="absolute top-1/2 -left-40 size-[30rem] rounded-full bg-logo/[0.07] blur-3xl"></div>
      <div class="absolute bottom-0 left-1/3 size-[26rem] rounded-full bg-accent/[0.08] blur-3xl dark:bg-accent/[0.04]"></div>
    </div>
    <div class="container-site grid items-center gap-12 py-14 lg:grid-cols-12 lg:gap-10 lg:py-24">
      <div class="animate-fade-up lg:col-span-6">
        <h1 class="eyebrow">Automobilių ir langų stiklų tamsinimas</h1>
        <p class="mt-6 text-[2.75rem] leading-[1.02] font-extrabold tracking-[-0.02em] text-balance text-text sm:text-6xl lg:text-[4.1rem]">
          Mažiau saulės.<br /><span class="text-link">Daugiau komforto.</span>
        </p>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
          Automobilių ir pastatų stiklų tamsinimas kokybiškomis plėvelėmis. Tvarkingas darbas, aiški kaina ir {site.warranty.short}
          – Kupiškyje, Rokiškyje ir Panevėžyje, atvykti galite iš visos Lietuvos. Pastatų langus klijuojame ir Vilniuje, Kaune bei kitur Lietuvoje.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#kontaktai" class="btn btn-primary !px-7 !py-3.5">Gauti pasiūlymą <ArrowRight size={18} aria-hidden="true" /></a>
          <a href="#kainos" class="btn btn-outline !px-7 !py-3.5">Peržiūrėti kainas</a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-[0.95rem] text-muted">
          {
            ['UV apsauga iki 99 %', 'Automobiliui – per 2–3 val.', site.warranty.short, `Patirtis nuo ${site.foundedYear} m.`].map((t) => (
              <li class="inline-flex items-center gap-2">
                <CircleCheck size={18} class="text-link" aria-hidden="true" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="animate-fade-up [animation-delay:150ms] lg:col-span-6 lg:pl-6">
        <TintSimulator />
      </div>
    </div>
  </section>

  <!-- ===== Nauda ===== -->
  <section id="nauda" class="section bg-bg-2">
    <div class="container-site">
      <SectionHeading eyebrow="Nauda" title="Kodėl verta tamsinti stiklus" lead="Kokybiška plėvelė – tai ne tik išvaizda. Ji saugo, vėsina ir suteikia ramybės kiekvieną dieną." />
      <div class="mt-12"><Benefits items={[...benefits]} /></div>
    </div>
  </section>

  <!-- ===== Paslaugos ===== -->
  <section id="paslaugos" class="section">
    <div class="container-site">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading eyebrow="Paslaugos" title="Ką klijuojame" lead="Dirbame su automobiliais, namais, biurais ir komercinėmis patalpomis. Padėsime išsirinkti plėvelę, kuri tinka būtent jums." />
        <a href="/paslaugos" class="btn btn-outline self-start lg:self-auto">Visos paslaugos <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          featured.map((s, i) => (
            <li class="reveal" style={`transition-delay:${(i % 3) * 80}ms`}>
              <ServiceCard service={s} photo />
            </li>
          ))
        }
      </ul>
      {
        other.length > 0 && (
          <div class="mt-8 flex flex-wrap items-center gap-2.5">
            <span class="mr-2 text-sm font-bold text-muted">Taip pat:</span>
            {other.map((s) => (
              <a href={serviceUrl(s.id)} class="chip">
                {s.data.title}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- ===== Atlikti darbai ===== -->
  <section id="darbai" class="section bg-bg-2">
    <div class="container-site">
      <SectionHeading eyebrow="Atlikti darbai" title="Mūsų darbai" lead="Tikros nuotraukos iš mūsų dirbtuvių ir objektų – automobiliai, žibintai, namai, biurai ir reklama." />
      <div class="mt-10"><Gallery groups={workGroups} limit={9} /></div>
    </div>
  </section>

  <!-- ===== Kaip dirbame ===== -->
  <section id="kaip-dirbame" class="section">
    <div class="container-site">
      <SectionHeading eyebrow="Kaip dirbame" title="Nuo skambučio iki rezultato – 4 žingsniai" />
      <div class="mt-12"><Steps /></div>
      <div class="mt-14"><CtaBand /></div>
    </div>
  </section>

  <!-- ===== Kainos ===== -->
  <section id="kainos" class="section bg-bg-2">
    <div class="container-site">
      <SectionHeading eyebrow="Kainos" title="Automobilių stiklų tamsinimo kainos" lead="Kainos pagal kėbulo tipą. Pastatams kaina skaičiuojama pagal stiklų plotą." />
      <div class="mt-12"><Pricing /></div>
    </div>
  </section>

  <!-- ===== Atsiliepimai ===== -->
  <section id="atsiliepimai" class="section">
    <div class="container-site">
      <SectionHeading eyebrow="Atsiliepimai" title="Klientų atsiliepimai Google" />
      <div class="mt-10"><GoogleReviews /></div>
    </div>
  </section>

  <!-- ===== Instagram ===== -->
  <section id="instagram" class="section bg-bg-2">
    <div class="container-site">
      <SectionHeading eyebrow="Instagram" title="Naujausi darbai mūsų Instagram" lead="Įrašai atsinaujina automatiškai – sekite mus ir pamatysite naujausius darbus pirmieji." class="mb-10" />
      <InstagramFeed />
    </div>
  </section>

  <!-- ===== Naujienos ===== -->
  {
    posts.length > 0 && (
      <section id="naujienos" class="section">
        <div class="container-site">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
            <SectionHeading eyebrow="Naujienos" title="Patarimai ir naujienos" lead="Naudinga informacija apie plėveles, jų priežiūrą ir taikomus reikalavimus." />
            <a href="/naujienos" class="btn btn-outline self-start lg:self-auto">
              Visi straipsniai <ArrowRight size={18} aria-hidden="true" />
            </a>
          </div>
          <ul class="mt-12 grid gap-5 md:grid-cols-3">
            {posts.map((p) => (
              <li class="reveal">
                <PostCard post={p} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ===== DUK ===== -->
  <section id="duk" class="section bg-bg-2">
    <div class="container-site grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading eyebrow="DUK" title="Dažnai užduodami klausimai" lead="Neradote atsakymo? Paskambinkite – mielai patarsime." />
      </div>
      <div class="lg:col-span-7"><Faq items={faq} /></div>
    </div>
  </section>

  <!-- ===== Kontaktai ===== -->
  <section id="kontaktai" class="section">
    <div class="container-site grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading eyebrow="Kontaktai" title="Susisiekite" lead="Paskambinkite, parašykite arba užpildykite formą – pateiksime pasiūlymą ir suderinsime laiką." />
        <ContactInfo />
        <p class="mt-8 mb-3 text-sm font-bold text-text">Stiklų tamsinimas jūsų mieste:</p>
        <ul class="flex flex-wrap gap-2">
          {cities.map((c) => (
            <li>
              <a href={cityUrl(c.slug)} class="chip">{c.name}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-7"><ContactForm /></div>
    </div>
  </section>
</BaseLayout>
