---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { googleAds, mailHref, metaPixel, site } from '@/config/site';

const crumbs = [
  { name: 'Pradžia', url: '/' },
  { name: 'Privatumo politika', url: '/privatumo-politika' },
];
const google = Boolean(googleAds.id);
const meta = Boolean(metaPixel.id);
const ads = google || meta;
const tags = [google && 'Google', meta && 'Meta'].filter(Boolean).join(' ir ');
---

<BaseLayout title="Privatumo politika | stiklutamsinimas.eu" description="Kaip svetainėje stiklutamsinimas.eu tvarkomi duomenys: slapukai, trečiųjų šalių paslaugos ir kontaktai.">
  <div class="container-site max-w-3xl pt-8 pb-24">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-10 text-4xl">Privatumo politika</h1>
    <div class="prose-site mt-8">
      <p>
        Svetainę <strong>{site.domain}</strong> administruoja {site.name}. Ši politika paaiškina, kokie duomenys tvarkomi jums lankantis
        svetainėje.
      </p>
      <h2>Užklausos ir žinutės</h2>
      <p>
        Svetainė neturi vartotojų paskyrų ir nesaugo jūsų užklausų. Užpildžius užklausos formą, žinutė tik paruošiama jūsų el. pašto
        programoje, WhatsApp arba Viber – ją išsiunčiate patys. Gautus kontaktus naudojame tik atsakyti į jūsų užklausą.
      </p>

      <h2 id="slapukai">Slapukai</h2>
      {
        ads ? (
          <>
            <p>
              Svetainė veikia ir be slapukų. Slapukus naudojame <strong>tik jums sutikus</strong> – iki tol {tags} žymos net neįkeliamos.
            </p>
            <ul>
              {google && (
                <li>
                  <strong>Google Ads</strong> (Google Ireland Ltd.) – matuoja, kiek lankytojų, atėjusių iš mūsų reklamos Google paieškoje,
                  paskambina ar parašo mums (paspaudimai ant telefono numerio, WhatsApp, Viber, Messenger, el. pašto ir užklausos formos).
                  Slapukai (pvz. <code>_gcl_au</code>) galioja iki 90 dienų. Google tai tvarko pagal savo{' '}
                  <a href="https://policies.google.com/privacy?hl=lt" target="_blank" rel="noopener">
                    privatumo politiką
                  </a>
                  .
                </li>
              )}
              {meta && (
                <li>
                  <strong>Meta Pixel</strong> (Meta Platforms Ireland Ltd.) – matuoja, kiek lankytojų, atėjusių iš mūsų reklamos Facebook ar
                  Instagram, susisiekia su mumis, ir leidžia rodyti mūsų reklamą Facebook bei Instagram jau apsilankiusiems svetainėje.
                  Slapukai (pvz. <code>_fbp</code>) galioja iki 90 dienų. Meta tai tvarko pagal savo{' '}
                  <a href="https://www.facebook.com/privacy/policy/" target="_blank" rel="noopener">
                    privatumo politiką
                  </a>
                  .
                </li>
              )}
            </ul>
            <p>
              Sutikimą galite bet kada pakeisti ar atšaukti: <a href="#slapukai" data-cookie-settings>slapukų nustatymai</a> (nuoroda yra ir
              kiekvieno puslapio apačioje). Atšaukus sutikimą, reklamos slapukai ištrinami.
              {meta ? 'Analitikos slapukų nenaudojame.' : 'Analitikos slapukų nenaudojame, reklamos pagal jūsų naršymą nepersonalizuojame.'}
            </p>
          </>
        ) : (
          <p>Svetainė nenaudoja reklaminių, analitikos ar kitų sekimo slapukų.</p>
        )
      }

      <h2>Naršyklėje saugoma informacija</h2>
      <p>
        Jei pasirenkate šviesią ar tamsią svetainės temą{ads && ' ar atsakote į slapukų klausimą'}, šis pasirinkimas išsaugomas tik
        jūsų naršyklėje (localStorage) ir mums neperduodamas.
      </p>
      <h2>Trečiųjų šalių paslaugos</h2>
      <ul>
        <li><strong>Google Maps</strong> – žemėlapiai kontaktų ir miestų puslapiuose. Juos atvaizduojant Google gali naudoti savo slapukus.</li>
        <li>
          <strong>YouTube</strong> – vaizdo įrašai rodomi „privatumo“ režimu (youtube-nocookie.com) ir įkeliami tik paspaudus ant vaizdo įrašo.
        </li>
        <li>
          <strong>Facebook Messenger, WhatsApp, Viber</strong> – paspaudus nuorodą atidaroma atitinkama programėlė; joje taikomos tų paslaugų
          taisyklės.
        </li>
        <li><strong>Cloudflare</strong> – svetainės talpinimas ir apsauga; renkama tik techninė, anoniminė informacija.</li>
      </ul>
      <h2>Jūsų teisės</h2>
      <p>
        Galite paprašyti susipažinti su savo duomenimis, juos ištaisyti ar ištrinti. Taip pat turite teisę pateikti skundą Valstybinei
        duomenų apsaugos inspekcijai (<a href="https://vdai.lrv.lt" target="_blank" rel="noopener">vdai.lrv.lt</a>).
      </p>
      <h2>Klausimai dėl duomenų</h2>
      <p>
        Klausimus dėl duomenų tvarkymo siųskite el. paštu <a href={mailHref}>{site.email}</a>.
      </p>
    </div>
  </div>
</BaseLayout>
